# Frontend .env.example — copy to .env (gitignored) and fill in real values.
# These are the ONLY variables the frontend bundle reads. Anything else
# (Resend API key, Zoho client secret, R2 keys, etc.) belongs in
# backend/.env — see backend/.env.example. Putting them here would inline
# them into the public JS bundle shipped to acschennai.com where anyone
# could scrape them.

# --- Backend API base URL ---
# Used by src/lib/env.js (Vite inlines import.meta.env at build time).
# All portal API calls are prefixed with this.
VITE_API_URL=https://acs-portal-api.azurewebsites.net

# --- Public-origin OAuth start URL (optional) ---
# The Zoho OAuth flow pops a window to /api/auth/zoho on the backend; this
# is the public site origin used to detect a successful callback (e.g. for
# analytics). Leave blank unless PortalLogin.jsx needs it.
# VITE_PUBLIC_OAUTH_REDIRECT=
