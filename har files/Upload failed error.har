            "size": 38815,
            "mimeType": "text/css",
            "text": ":root{--white: #FFFFFF;--off-white: #F8F9FA;--light-gray: #F1F5F9;--border: #E2E8F0;--steel: #64748B;--navy: #0B1929;--navy-mid: #1B2D42;--blue: #0066FF;--blue-light: #3385FF;--amber: #F59E0B;--shadow-sm: 0 2px 8px rgba(0,0,0,.06);--shadow-md: 0 8px 24px rgba(0,0,0,.08);--shadow-lg: 0 16px 40px rgba(0,0,0,.1);--shadow-xl: 0 24px 60px rgba(0,0,0,.12);--radius: 12px;--radius-lg: 18px}*{box-sizing:border-box;overflow-x:hidden}body{margin:0;font-family:Inter,sans-serif;color:var(--navy);background:var(--white);-webkit-font-smoothing:antialiased}::selection{background:var(--blue);color:#fff}::-webkit-scrollbar{width:6px}::-webkit-scrollbar-track{background:var(--light-gray)}::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:3px}::-webkit-scrollbar-thumb:hover{background:var(--blue)}img{max-width:100%;display:block}a{text-decoration:none}.container{max-width:1180px;margin:0 auto;padding:0 1.5rem}.section{padding:5rem 0}.section.alt{background:var(--off-white)}.display-xl{font-family:Plus Jakarta Sans,sans-serif;font-weight:800;font-size:clamp(2.6rem,5.5vw,5rem);line-height:1.08;letter-spacing:-.025em;color:var(--navy)}.display-lg{font-family:Plus Jakarta Sans,sans-serif;font-weight:800;font-size:clamp(1.8rem,3.5vw,3rem);line-height:1.12;letter-spacing:-.02em;color:var(--navy)}.heading-lg{font-family:Plus Jakarta Sans,sans-serif;font-weight:700;font-size:clamp(1.3rem,2vw,1.8rem);line-height:1.25;color:var(--navy)}.heading-md{font-family:Plus Jakarta Sans,sans-serif;font-weight:700;font-size:1.2rem;line-height:1.3;color:var(--navy)}.body-lg{font-size:1.1rem;line-height:1.7;color:var(--steel)}.body-md{font-size:.95rem;line-height:1.7;color:var(--steel)}.muted{color:#94a3b8}.accent{color:var(--blue)}.amber{color:var(--amber)}header{position:sticky;top:0;z-index:100;background:#ffffffe6;backdrop-filter:blur(16px) saturate(160%);-webkit-backdrop-filter:blur(16px) saturate(160%);border-bottom:1px solid var(--border);box-shadow:0 1px 20px #0000000a}header .container{display:flex;align-items:center;justify-content:space-between;padding:.85rem 1.5rem}.header-logo{display:flex;align-items:center;gap:.6rem;font-family:Plus Jakarta Sans,sans-serif;font-weight:800;font-size:1.1rem;color:var(--navy);letter-spacing:.3px}.header-logo .logo-icon{width:34px;height:34px;background:var(--blue);border-radius:8px;display:grid;place-items:center;flex-shrink:0}nav{display:flex;align-items:center;gap:.2rem}nav a{color:var(--steel);text-decoration:none;font-weight:500;font-size:.88rem;padding:.4rem .8rem;border-radius:8px;transition:color .2s ease,background .2s ease;letter-spacing:.01em}nav a:hover{color:var(--navy);background:var(--light-gray)}nav a.active{color:var(--blue);background:#0066ff0f;border-bottom:2px solid var(--blue);font-weight:700}.nav-cta{background:var(--blue)!important;color:#fff!important;font-weight:600!important;padding:.4rem 1rem!important;border-radius:8px!important;margin-left:.4rem;box-shadow:0 2px 8px #0066ff4d}.nav-cta:hover{background:var(--blue-light)!important;transform:translateY(-1px);box-shadow:0 4px 14px #06f6;color:#fff!important}.mobile-menu-toggle{display:none;background:none;border:none;cursor:pointer;color:var(--navy);padding:.4rem;border-radius:8px}.mobile-menu-toggle:hover{background:var(--light-gray)}.hero{position:relative;min-height:88vh;display:flex;align-items:center;overflow:hidden;background:var(--navy)}.hero-image-wrap{position:absolute;inset:0;z-index:0}.hero-img{width:100%;height:100%;object-fit:cover;filter:brightness(.92) saturate(1.1) contrast(1.05)}.hero-img-overlay{position:absolute;inset:0;background:linear-gradient(120deg,#0b19298c,#0b192959 55%,#0b192926)}.hero-orb{position:absolute;border-radius:9999px;pointer-events:none}.hero-orb-1{width:500px;height:500px;background:#0066ff0f;top:-10%;left:-5%;filter:blur(80px)}.hero-orb-2{width:400px;height:400px;background:#f59e0b0d;bottom:-5%;right:-5%;filter:blur(80px)}.hero-content{position:relative;z-index:2;padding:5rem 0 4rem;max-width:820px}.hero-eyebrow{background:#0066ff26;border:1px solid rgba(0,102,255,.3);color:#93c5fd}.hero .display-xl{color:#fff}.hero .body-lg{color:#ffffffb3}.hero-orb{z-index:1}.hero-ctas{display:flex;gap:.85rem;flex-wrap:wrap;animation:fade-in-up .7s ease .3s both}.about-strip{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center}.about-strip-img{border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-lg)}.about-strip-img img{width:100%;height:380px;object-fit:cover;display:block}.about-strip-text .section-title{text-align:left;margin-bottom:.75rem}.about-strip-text .section-sub{margin-bottom:0}.about-strip-text .section-eyebrow{display:block}.btn{display:inline-flex;align-items:center;gap:.4rem;border:0;cursor:pointer;font-family:Inter,sans-serif;font-weight:600;font-size:.93rem;border-radius:var(--radius);padding:.72rem 1.35rem;transition:transform .18s ease,box-shadow .18s ease,background .2s ease;text-decoration:none;white-space:nowrap}.btn:active{transform:translateY(2px)}.btn-primary{background:var(--blue);color:#fff;box-shadow:0 2px 12px #0066ff4d}.btn-primary:hover{background:var(--blue-light);transform:translateY(-2px);box-shadow:0 6px 20px #06f6}.btn-ghost{background:var(--white);color:var(--navy);border:1px solid var(--border);box-shadow:var(--shadow-sm)}.btn-ghost:hover{background:var(--light-gray);transform:translateY(-2px);box-shadow:var(--shadow-md)}.btn-amber{background:var(--amber);color:#fff;box-shadow:0 2px 12px #f59e0b4d}.btn-amber:hover{background:#fbbf24;transform:translateY(-2px);box-shadow:0 6px 20px #f59e0b66}.spinner{display:inline-block;width:18px;height:18px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .8s linear infinite;flex-shrink:0;margin-right:.4rem;vertical-align:middle}@keyframes spin{to{transform:rotate(360deg)}}.stats-bar{background:var(--navy);padding:2.5rem 0}.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem}.stat-item{text-align:center}.stat-number{font-family:Plus Jakarta Sans,sans-serif;font-weight:800;font-size:clamp(1.8rem,3vw,2.8rem);color:var(--white);line-height:1;margin-bottom:.4rem}.stat-label{font-size:.8rem;font-weight:600;color:#ffffff80;text-transform:uppercase;letter-spacing:.1em}.services-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.2rem}.service-card{background:var(--white);border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.6rem 1.3rem;transition:transform .25s ease,box-shadow .25s ease,border-color .25s ease;box-shadow:var(--shadow-sm)}.service-card:hover{transform:translateY(-5px);box-shadow:var(--shadow-lg);border-color:#06f3}.service-icon{width:48px;height:48px;background:#0066ff14;border-radius:12px;display:grid;place-items:center;margin-bottom:1.1rem}.service-card h3{font-family:Plus Jakarta Sans,sans-serif;font-weight:700;font-size:1rem;color:var(--navy);margin:0 0 .5rem}.service-card p{font-size:.88rem;color:var(--steel);margin:0;line-height:1.6}.process-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:0;position:relative}.process-steps:before{content:\"\";position:absolute;top:26px;left:12%;right:12%;height:2px;background:linear-gradient(90deg,var(--blue) 0%,var(--border) 100%);opacity:.4}.process-step{text-align:center;padding:0 .8rem;position:relative}.process-num{width:52px;height:52px;background:var(--white);border:2px solid var(--blue);border-radius:50%;display:grid;place-items:center;margin:0 auto 1.1rem;font-family:Plus Jakarta Sans,sans-serif;font-weight:800;font-size:1rem;color:var(--blue);position:relative;z-index:1;box-shadow:0 2px 8px #0066ff26}.process-step h4{font-family:Plus Jakarta Sans,sans-serif;font-weight:700;font-size:.93rem;color:var(--navy);margin:0 0 .25rem}.process-step p{font-size:.8rem;color:var(--steel);margin:0}.testimonial-card{background:var(--white);border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.8rem 1.6rem;box-shadow:var(--shadow-sm);position:relative}.testimonial-quote{position:absolute;top:1rem;left:1.2rem;font-size:4.5rem;color:var(--blue);opacity:.12;font-family:Georgia,serif;line-height:1}.testimonial-text{font-size:1rem;color:var(--navy-mid);line-height:1.7;font-style:italic;margin-bottom:1.1rem;position:relative;z-index:1}.testimonial-author{display:flex;align-items:center;gap:.75rem}.testimonial-avatar{width:42px;height:42px;border-radius:50%;object-fit:cover;border:2px solid var(--border)}.testimonial-name{font-weight:700;font-size:.88rem;color:var(--navy)}.testimonial-title{font-size:.78rem;color:var(--steel)}.project-card{border-radius:var(--radius-lg);overflow:hidden;background:var(--white);border:1px solid var(--border);box-shadow:var(--shadow-sm);transition:transform .3s ease,box-shadow .3s ease}.project-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-xl)}.project-card .cover{width:100%;height:210px;object-fit:cover;transition:transform .4s ease}.project-card:hover .cover{transform:scale(1.03)}.project-card-body{padding:1.4rem}.project-tag{display:inline-block;background:#0066ff14;color:var(--blue);font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;padding:.2rem .6rem;border-radius:999px;margin-bottom:.65rem}.project-card h3{font-family:Plus Jakarta Sans,sans-serif;font-weight:700;font-size:1.05rem;color:var(--navy);margin:0 0 .45rem}.project-card p{font-size:.88rem;color:var(--steel);margin:0 0 .75rem;line-height:1.6}.project-metric{display:flex;align-items:center;gap:.4rem;font-family:Plus Jakarta Sans,sans-serif;font-weight:700;font-size:.88rem;color:var(--amber)}.blog-card{background:var(--white);border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.5rem;box-shadow:var(--shadow-sm);transition:transform .25s ease,box-shadow .25s ease,border-color .25s ease}.blog-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-md);border-color:#0066ff26}.blog-card .date{font-size:.75rem;color:var(--steel);margin-bottom:.4rem}.blog-card h3{font-family:Plus Jakarta Sans,sans-serif;font-weight:700;color:var(--navy);margin:0 0 .45rem;font-size:1.05rem}.blog-card p{font-size:.87rem;color:var(--steel);margin:0 0 .9rem;line-height:1.6}.blog-card .read-more{color:var(--blue);font-weight:600;font-size:.87rem}.job-card{background:var(--white);border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.5rem;box-shadow:var(--shadow-sm);transition:transform .2s ease,box-shadow .2s ease}.job-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-md)}.job-card h3{font-family:Plus Jakarta Sans,sans-serif;font-weight:700;color:var(--navy);margin:0 0 .3rem;font-size:1.05rem}.job-location{font-size:.82rem;color:var(--steel);margin-bottom:.6rem}.job-tags{display:flex;gap:.4rem;flex-wrap:wrap;margin-bottom:.9rem}.job-tag{background:#0066ff12;color:var(--blue);font-size:.7rem;font-weight:700;padding:.18rem .55rem;border-radius:6px}.section-eyebrow{display:inline-block;font-size:.73rem;font-weight:800;text-transform:uppercase;letter-spacing:.14em;color:var(--blue);margin-bottom:.75rem}.section-title{font-family:Plus Jakarta Sans,sans-serif;font-weight:800;font-size:clamp(1.7rem,3vw,2.6rem);color:var(--navy);margin:0 0 .7rem;line-height:1.15}.section-sub{font-size:1.02rem;color:var(--steel);margin-bottom:2.8rem;max-width:540px}.section-header{text-align:center;margin-bottom:2.8rem}.section-header .section-sub{margin:0 auto}.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:1.4rem}.grid-2{display:grid;grid-template-columns:repeat(2,1fr);gap:1.4rem}.contact-split{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:start}.form-group{display:flex;flex-direction:column;gap:.3rem}.form-group label{font-weight:600;font-size:.86rem;color:var(--navy)}.form-input{width:100%;padding:.78rem 1rem;background:var(--white);border:1px solid var(--border);border-radius:10px;font-size:.93rem;color:var(--navy);font-family:Inter,sans-serif;transition:border-color .2s ease,box-shadow .2s ease;box-shadow:var(--s