            "mimeType": "text/html",
            "text": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>ACS Chennai — Construction Project Management Consultancy</title>\n    <meta name=\"description\" content=\"ACS Chennai is a construction project management consultancy in Oragadam, Chennai. Serving clients across India in pharma, chemical, logistics, and industrial construction. PMC mandates for chemical, pharmaceutical, residential, and industrial projects.\" />\n    <meta property=\"og:title\" content=\"ACS Chennai — Construction Project Management Consultancy\" />\n    <meta property=\"og:description\" content=\"Construction project management consultancy in Oragadam, Chennai. 35+ years experience serving chemical, pharmaceutical, residential and industrial clients across India.\" />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:url\" content=\"https://acschennai.com\" />\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n    <meta name=\"twitter:title\" content=\"ACS Chennai — Construction Project Management Consultancy\" />\n    <meta name=\"twitter:description\" content=\"Construction PMC in Oragadam, Chennai. Serving pharma, chemical, logistics and industrial clients across India.\" />\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\" />\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/logo.svg\" />\n    <script type=\"module\" crossorigin src=\"/assets/index-DVZ9eeBC.js\"></script>\n    <link rel=\"stylesheet\" crossorigin href=\"/assets/index-Cqo1llAc.css\">\n  </head>\n  <body>\n    <div id=\"root\"></div>\n  </body>\n</html>\n"
