// SINGLE-TENANT: ACS Chennai employee portal. See TENANCY.md before
// adding any field that scopes by organization/project — every query,
// storage path, OAuth admission, and admin predicate must filter.

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id                     String               @id @default(uuid())
  email                  String               @unique
  password               String?
  name                   String
  designation            String?
  department             String?
  isAdmin                Boolean              @default(false) @map("is_admin")
  zohoAccessToken        String?              @map("zoho_access_token")
  zohoRefreshToken       String?              @map("zoho_refresh_token")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  attendance             Attendance[]
  dprSubmitted           DPR[]                @relation("DPRSubmitter")
  dprReviewed            DPR[]                @relation("DPRReviewer")
  dprApproved            DPR[]                @relation("DPRApprover")
  inspectionSubmitted    InspectionRecord[]   @relation("InspectionSubmitter")
  notifications          Notification[]
  leaveRequests          LeaveRequest[]       @relation("LeaveSubmitter")
  leaveReviewed          LeaveRequest[]       @relation("LeaveReviewer")
  trainingCoursesCreated TrainingCourse[]     @relation("CourseCreatedBy")
  trainingEnrollments    TrainingEnrollment[] @relation("EnrollEmployee")
  trainingAssignedByMe   TrainingEnrollment[] @relation("EnrollAssignedBy")
  // Round-25: email notification preferences + audit log + digest runs.
  // NotificationPreference is 1:1 (PK = employeeId); EmailLog / DigestRun
  // are 1:N and outlive notification rows via onDelete: SetNull.
  notificationPreference NotificationPreference?
  emailLogs              EmailLog[]
  digestRuns             DigestRun[]

  @@map("employees")
}

// ─────────────────────────────────────────────
// Session revocation (Round-20 / DR-005)
// ─────────────────────────────────────────────
// Before DR-005 logout wrote the access-token `jti` to a process-local Map
// that requireAuth never consulted, so "sign out" revoked nothing at all —
// and refresh tokens were pure stateless JWTs, valid for their full 7 days
// even after logout. Both facts are now backed by rows in this database, so
// revocation survives a Render restart / redeploy.
//
// Deliberately NOT related (`@relation`) to Employee:
//   - a revocation record must outlive the employee row it refers to
//     (deleting an employee must never resurrect their live tokens via a
//     cascade), and
//   - the auth middleware reads these on the hot path by primary key only;
//     it never needs to join to `employees`.
// `employeeId` is therefore a plain column kept for audit/bulk-revoke, not
// an FK. Both tables are prunable by `expiresAt` (see lib/revocation.js
// pruneExpired) because a row is worthless once the token it denies has
// expired on its own.

model RevokedToken {
  // The access token's `jti` claim — 128 bits of crypto randomness, so it is
  // the natural primary key. One row == one access token that must be refused.
  jti        String   @id
  employeeId String   @map("employee_id")
  revokedAt  DateTime @default(now()) @map("revoked_at")
  // Mirrors the JWT `exp` claim (converted from seconds to a timestamp) so the
  // pruner can delete rows that can no longer deny anything.
  expiresAt  DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("revoked_token")
}

model RefreshToken {
  id String @id @default(uuid())

  employeeId String @map("employee_id")
  // sha256(refresh JWT). We store the DIGEST, never the token: a read-only
  // leak of this table (SQL injection, stray backup, support query) must not
  // hand out usable 7-day credentials.
  tokenHash  String @unique @map("token_hash")

  createdAt DateTime @default(now()) @map("created_at")
  // Rotation chain: points at the row this token replaced. Lets an operator
  // walk a session's history and lets the reuse-detection path prove that a
  // replayed token really was superseded rather than forged.
  rotatedFromId String?   @map("rotated_from_id")
  expiresAt     DateTime  @map("expires_at")
  // Non-null == spent (rotated) or explicitly killed (logout / theft
  // response). Presenting a row that already has `revokedAt` set is the
  // reuse signal that nukes every session for the employee.
  revokedAt     DateTime? @map("revoked_at")
  lastUsedAt    DateTime? @map("last_used_at")

  @@index([employeeId])
  @@index([expiresAt])
  @@map("refresh_token")
}

model Attendance {
  id         String              @id @default(uuid())
  employeeId String              @map("employee_id")
  date       DateTime            @db.Date
  status     String              @default("Present")
  notes      String?
  createdAt  DateTime            @default(now()) @map("created_at")
  employee   Employee            @relation(fields: [employeeId], references: [id])
  sessions   AttendanceSession[]

  @@unique([employeeId, date])
  // Round-7: admin attendance dashboard queries by month (`WHERE date BETWEEN ...`)
  // without this index the dashboard hits a sequential scan once the table grows.
  @@index([date])
  @@map("attendance")
}

model AttendanceSession {
  id           String     @id @default(uuid())
  attendanceId String     @map("attendance_id")
  checkIn      DateTime   @map("check_in")
  checkInLat   Decimal?   @map("check_in_lat") @db.Decimal(10, 7)
  checkInLng   Decimal?   @map("check_in_lng") @db.Decimal(10, 7)
  checkInAddr  String?    @map("check_in_addr")
  checkOut     DateTime?  @map("check_out")
  checkOutLat  Decimal?   @map("check_out_lat") @db.Decimal(10, 7)
  checkOutLng  Decimal?   @map("check_out_lng") @db.Decimal(10, 7)
  checkOutAddr String?    @map("check_out_addr")
  createdAt    DateTime   @default(now()) @map("created_at")
  attendance   Attendance @relation(fields: [attendanceId], references: [id])

  // Round-13: attendanceId used by every session list query under an attendance row.
  // Without this index, the timesheet exporter's per-row session fetch hits a seq scan.
  @@index([attendanceId])
  @@map("attendance_sessions")
}

// ─────────────────────────────────────────────
// DPR Module
// ─────────────────────────────────────────────

enum DPRStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model DPR {
  id                       String    @id @default(uuid())
  projectName              String
  location                 String
  reportDate               DateTime  @db.Date
  weather                  String?
  temperature              String?
  contractor               String?
  workType                 String    @default("MATERIAL_RECEIPT")
  notes                    String?
  // Round-12 DPR refactor: 5 daily-narrative fields requested by the PMC
  // domain review (work executed / location / manpower / risks / materials
  // summary) + a customSections JSON blob for the user's ad-hoc text + table
  // blocks added via the "+" button. workEntries is kept (nullable, deprecated)
  // so old DPRs render without a migration step.
  workExecutedToday        String?   @map("work_executed_today")
  workLocation             String?   @map("work_location")
  manpowerSummary          String?   @map("manpower_summary")
  risksHindrances          String?   @map("risks_hindrances")
  materialsReceivedSummary String?   @map("materials_received_summary")
  customSections           Json?     @map("custom_sections")
  workEntries              Json?
  status                   DPRStatus @default(DRAFT)
  version                  Int       @default(1)
  submittedById            String    @map("submitted_by_id")
  reviewedById             String?   @map("reviewed_by_id")
  approvedById             String?   @map("approved_by_id")
  submittedAt              DateTime? @map("submitted_at")
  reviewedAt               DateTime? @map("reviewed_at")
  approvedAt               DateTime? @map("approved_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  submittedBy   Employee           @relation("DPRSubmitter", fields: [submittedById], references: [id])
  reviewedBy    Employee?          @relation("DPRReviewer", fields: [reviewedById], references: [id])
  approvedBy    Employee?          @relation("DPRApprover", fields: [approvedById], references: [id])
  photos        DPRPhoto[]
  revisions     DPRRevision[]
  notifications Notification[]
  inspections   InspectionRecord[]

  @@unique([submittedById, reportDate])
  @@index([reportDate, id])
  @@map("dpr")
}

model DPRPhoto {
  id          String    @id @default(uuid())
  dprId       String    @map("dpr_id")
  ulid        String
  container   String
  filename    String
  contentType String    @map("content_type")
  sizeBytes   Int       @map("size_bytes")
  caption     String?
  location    String?
  takenAt     DateTime? @map("taken_at")
  uploadedAt  DateTime  @default(now()) @map("uploaded_at")

  dpr DPR @relation(fields: [dprId], references: [id], onDelete: Cascade)

  // Round-7: dprId used in every DPR detail query (joins) — without this
  // index each GET /api/dpr/:id hits a seq scan on dpr_photo. ulid is
  // queried by the orphan-blob cleanup job and by PATCH confirm-upload.
  @@index([dprId])
  @@index([ulid])
  @@map("dpr_photo")
}

model DPRRevision {
  id          String   @id @default(uuid())
  dprId       String   @map("dpr_id")
  version     Int
  snapshot    Json
  changedAt   DateTime @default(now()) @map("changed_at")
  changedById String   @map("changed_by_id")

  dpr DPR @relation(fields: [dprId], references: [id], onDelete: Cascade)

  @@unique([dprId, version])
  // Round-7: revision list reads by dprId + ordering by changedAt; without
  // this index the audit trail read on /api/dpr/:id history hits a seq scan.
  @@index([dprId, changedAt])
  @@map("dpr_revision")
}

// ─────────────────────────────────────────────
// Inspection & Compliance Records Module (Round-12)
// ─────────────────────────────────────────────
// 15 sub-work types (material / cube / water / waterproofing / villa / day-
// activity / NCR / safety / major_deviation) used to live as nested rows
// inside DPR.workEntries. They are now first-class records that:
//   - FK to a DPR (nullable — for filings on Sundays / holidays)
//   - carry their own photos (DPR photos stay on the DPR)
//   - can be filtered by date range, project, type, severity, status
// inspectionType is the SUB_WORK_TYPE_OPTIONS value (e.g. 'material_inspection',
// 'cube_casting', 'ncr', 'safety_violation'). The structured field payload per
// type lives in WORK_TYPE_FIELDS (frontend/src/pages/portal/DprWorkTypes.jsx)
// and is stored as JSON in `data` for forward compatibility.

model InspectionRecord {
  id             String   @id @default(uuid())
  projectName    String
  location       String
  reportDate     DateTime @db.Date
  weather        String?
  contractor     String?
  dprId          String?  @map("dpr_id")
  inspectionType String   @map("inspection_type")
  data           Json
  status         String   @default("OPEN")
  // severity is meaningful for NCR / safety_violation / major_deviation;
  // null for routine inspections (material receipt, cube test, etc.).
  severity       String?
  submittedById  String   @map("submitted_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  dpr         DPR?              @relation(fields: [dprId], references: [id])
  submittedBy Employee          @relation("InspectionSubmitter", fields: [submittedById], references: [id])
  photos      InspectionPhoto[]

  // Indexes mirror DPR's pattern: owner + date for "my inspections this week",
  // dprId for "show me inspections on this DPR", and (date,id) for cursor
  // pagination in list views.
  @@index([submittedById, reportDate])
  @@index([dprId])
  @@index([reportDate, id])
  @@index([inspectionType])
  @@map("inspection_record")
}

model InspectionPhoto {
  id           String    @id @default(uuid())
  inspectionId String    @map("inspection_id")
  ulid         String
  container    String
  filename     String
  contentType  String    @map("content_type")
  sizeBytes    Int       @map("size_bytes")
  caption      String?
  location     String?
  takenAt      DateTime? @map("taken_at")
  uploadedAt   DateTime  @default(now()) @map("uploaded_at")

  inspection InspectionRecord @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@index([ulid])
  @@map("inspection_photo")
}

model Notification {
  id                   String   @id @default(uuid())
  employeeId           String   @map("employee_id")
  type                 String
  dprId                String?  @map("dpr_id")
  leaveRequestId       String?  @map("leave_request_id")
  trainingEnrollmentId String?  @map("training_enrollment_id")
  message              String
  isRead               Boolean  @default(false) @map("is_read")
  createdAt            DateTime @default(now()) @map("created_at")

  employee           Employee            @relation(fields: [employeeId], references: [id])
  dpr                DPR?                @relation(fields: [dprId], references: [id])
  leaveRequest       LeaveRequest?       @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)
  trainingEnrollment TrainingEnrollment? @relation(fields: [trainingEnrollmentId], references: [id], onDelete: SetNull)
  // Round-25: back-relation to the email audit log. SetNull so a notification
  // row can be pruned without orphaning the audit history of who got the email.
  emailLogs          EmailLog[]

  @@index([employeeId, createdAt])
  // Round-7: dpr relation is included in many read queries; index for joins.
  @@index([dprId])
  // Round-13: leave notifications join through leaveRequestId on the bell feed.
  @@index([leaveRequestId])
  // Round-14 (training module): training notifications join through
  // trainingEnrollmentId on the bell feed; mirror the leaveRequestId pattern.
  @@index([trainingEnrollmentId])
  @@map("notification")
}

// ─────────────────────────────────────────────
// Leave Request Module (Round-13)
// ─────────────────────────────────────────────
// Standard leave request workflow:
//   1. Employee submits POST /api/leave (status=PENDING).
//   2. Admin reviews via /portal/admin/leave; approve or reject
//      (status → APPROVED / REJECTED, with reviewedById/reviewedAt set).
//   3. Employee may cancel a PENDING request (status → CANCELLED).
//
// LeaveType is a string validated server-side (not an enum) so adding new
// leave categories (e.g. MATERNITY, COMP_OFF) is a non-migration change.
//
// Future extensibility hooks baked in:
//   - `metadata Json?` — for attachments, half-day flags, custom HR policies
//   - `cancelledAt` + `reviewNotes` columns present from day 1 so audit flows
//     in v2 don't need a schema migration.
//   - No `dayCount` column (holiday/weekend policy changes don't require
//     backfill).
//
// Indexes chosen for the hot reads:
//   - employee dashboard "my recent leave" → (employeeId, startDate)
//   - admin queue "pending leave oldest first" → (status, startDate)

model LeaveRequest {
  id           String    @id @default(uuid())
  employeeId   String    @map("employee_id")
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  leaveType    String    @default("CASUAL") @map("leave_type")
  reason       String
  status       String    @default("PENDING")
  reviewedById String?   @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewNotes  String?   @map("review_notes")
  cancelledAt  DateTime? @map("cancelled_at")
  metadata     Json?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  employee      Employee       @relation("LeaveSubmitter", fields: [employeeId], references: [id])
  reviewedBy    Employee?      @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  notifications Notification[]

  @@index([employeeId, startDate])
  @@index([status, startDate])
  @@index([startDate, endDate])
  @@map("leave_request")
}

// ─────────────────────────────────────────────
// Employee Training Module (Round-14)
// ─────────────────────────────────────────────
// Admin assigns external training courses (LinkedIn Learning, Coursera,
// Udemy, YouTube, Vimeo, etc.) to one or more employees at once. Employees
// watch the course embedded in the portal; the player captures watch
// progress via the YouTube / Vimeo IFrame APIs and PATCHes it back to the
// server every ~10s. Status auto-flips to COMPLETED when the player's
// `ended` event fires (progress >= 100).
//
// Single video per course in v1 — adding multi-lesson courses later is a
// purely additive schema change (insert a TrainingLesson table with a
// `(courseId, order)` unique key and roll progress up from lessons to the
// parent enrollment).
//
// Notification model gained a `trainingEnrollmentId` FK so the bell feed
// shows "You have a new training: …" / "Training completed: …" entries
// alongside the existing DPR + leave notifications.
//
// Indexes chosen for the hot reads:
//   - employee "My Learning" hub → (employeeId, status)
//   - admin dashboard "pending-by-status + due date" → (status, dueDate)
//   - admin course catalog "active courses newest first" → (isArchived, createdAt)

enum TrainingProvider {
  YOUTUBE
  VIMEO
  LINKEDIN_LEARNING
  COURSERA
  UDEMY
  OTHER
}

// Round-20 (DR-010): evidence provenance. The previous `COMPLETED` value
// collapsed four distinct completion paths (self-attest, player, provider
// webhook, admin override) into one indistinguishable terminal state, so
// the admin UI could not tell a watched-to-end course from a one-click
// attestation. Split into four explicit completed-states — each carries a
// matching `evidenceClass` string for filtering/reporting and an optional
// `completedBy` actor id. OVERDUE and CANCELLED are bookkeeping states for
// admin operations (cron / bulk-cancel) — not user-driven in v1.
enum TrainingEnrollmentStatus {
  ASSIGNED // not yet started
  IN_PROGRESS // watched > 0% and < 100%
  SELF_ATTESTED_COMPLETED // employee clicked "I'm done" (no player data)
  PLAYER_OBSERVED_COMPLETED // YouTube/Vimeo IFrame ended=true event
  PROVIDER_VERIFIED_COMPLETED // future: Coursera/Udemy webhook confirmation
  ADMIN_OVERRIDE_COMPLETED // admin clicked override on employee's behalf
  OVERDUE // past dueDate + not completed (admin/cron)
  CANCELLED // admin cancelled the assignment
}

enum TrainingPriority {
  LOW
  NORMAL
  HIGH
}

model TrainingCourse {
  id           String           @id @default(uuid())
  title        String           @db.VarChar(160)
  description  String?
  externalUrl  String           @map("external_url") @db.VarChar(2048)
  provider     TrainingProvider
  category     String?          @db.VarChar(60)
  durationHint Int?             @map("duration_hint")
  isArchived   Boolean          @default(false) @map("is_archived")
  createdById  String           @map("created_by_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  createdBy   Employee             @relation("CourseCreatedBy", fields: [createdById], references: [id])
  enrollments TrainingEnrollment[]

  @@index([isArchived, createdAt])
  @@index([provider])
  @@map("training_course")
}

model TrainingEnrollment {
  id                String                   @id @default(uuid())
  courseId          String                   @map("course_id")
  employeeId        String                   @map("employee_id")
  assignedById      String                   @map("assigned_by_id")
  assignedAt        DateTime                 @default(now()) @map("assigned_at")
  dueDate           DateTime?                @map("due_date") @db.Date
  priority          TrainingPriority         @default(NORMAL)
  status            TrainingEnrollmentStatus @default(ASSIGNED)
  progressPct       Int                      @default(0) @map("progress_pct")
  lastWatchedSec    Int                      @default(0) @map("last_watched_sec")
  startedAt         DateTime?                @map("started_at")
  // Round-20 (DR-010): separate from updatedAt so the actual completion
  // instant is queryable; null until the enrollment hits a completed-state.
  completedAt       DateTime?                @map("completed_at")
  // Round-20 (DR-010) evidence provenance — one of SELF_ATTESTED |
  // PLAYER_OBSERVED | PROVIDER_VERIFIED | ADMIN_OVERRIDE. Null until
  // the enrollment is completed; matches status suffix (SELF_ATTESTED ↔
  // SELF_ATTESTED_COMPLETED, etc.) so reports can GROUP BY either column.
  evidenceClass     String?                  @map("evidence_class") @db.VarChar(40)
  // Actor who flipped the row to a completed-state. Equals employeeId for
  // SELF_ATTESTED, a watching session for PLAYER_OBSERVED (still the
  // employee's own row, but recorded for audit), or an admin id for
  // ADMIN_OVERRIDE. Null while the enrollment is open.
  completedBy       String?                  @map("completed_by")
  // Player session payload / provider webhook payload (claim position, claimed
  // watch duration, raw player event timestamp). Used for audit and to
  // defend the auto-complete against a fake `ended=true` from a tampered
  // client. Json? so the schema doesn't pin us to a provider's field shape.
  evidenceMetadata  Json?                    @map("evidence_metadata")
  // Future provider webhook id (Coursera/Udemy completion id, etc.) so we
  // can reconcile duplicate webhooks against the original enrollment row.
  providerSessionId String?                  @map("provider_session_id") @db.VarChar(120)
  employeeNote      String?                  @map("employee_note") @db.VarChar(500)
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  course        TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employee      Employee       @relation("EnrollEmployee", fields: [employeeId], references: [id])
  assignedBy    Employee       @relation("EnrollAssignedBy", fields: [assignedById], references: [id])
  notifications Notification[]

  // A given employee can only have one enrollment per course — bulk-assign
  // is idempotent on this pair (existing row is reused if present).
  @@unique([courseId, employeeId])
  @@index([employeeId, status])
  @@index([status, dueDate])
  @@index([assignedAt])
  // Round-20: completion reports filter by evidenceClass; partial index
  // keeps it tight (only completed rows have an evidenceClass value).
  @@index([evidenceClass])
  @@map("training_enrollment")
}

// ─────────────────────────────────────────────
// Round-25: Email Notification System
// ─────────────────────────────────────────────
//
// Four new tables power the transactional-email transport added alongside the
// existing in-app SSE feed (Notification table is unchanged). The split keeps
// each layer's data minimal and indexable for its own hot path:
//
//   - NotificationPreference (1:1 with Employee, PK = employeeId) — per-user
//     switches. emailEnabled is the master kill switch; digestEnabled opts
//     out of the daily digest (still receives immediate emails); typeMutes
//     blocks specific notification types entirely. digestHourLocal captures
//     the user's preferred send hour (0-23, IST) for the daily digest.
//
//   - EmailLog — append-only audit trail for every email dispatch attempt
//     (sent, failed, opted-out, missing-address). notificationId is SetNull
//     so a notification row can be pruned without orphaning the audit.
//
//   - DigestRun + DigestItem — book-keeping for the daily digest cron. The
//     @@unique([employeeId, scheduledFor]) is the idempotency key: a second
//     cron fire on the same day is a no-op. DigestItem records which
//     notifications were bundled into a given run.

model NotificationPreference {
  employeeId       String   @id @map("employee_id")
  emailEnabled     Boolean  @default(true) @map("email_enabled")
  digestEnabled    Boolean  @default(true) @map("digest_enabled")
  // Free-form JSON object: { "<NOTIFICATION_TYPE>": true }. Reads tolerate
  // unknown type strings (forward-compat) and missing keys (default = false,
  // i.e. NOT muted).
  typeMutes        Json     @default("{}") @map("type_mutes")
  // 0-23, default 8 AM IST. Out-of-range values are rejected at the API
  // layer; the cron uses Date.now() in TZ=Asia/Kolkata for the actual send
  // window matching.
  digestHourLocal  Int      @default(8) @map("digest_hour_local")
  updatedAt        DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("notification_preference")
}

model EmailLog {
  id                String   @id @default(uuid())
  employeeId        String   @map("employee_id")
  notificationId    String?  @map("notification_id")
  recipientEmail    String   @map("recipient_email")
  subject           String
  // "IMMEDIATE" — single notification email. "DIGEST" — daily digest bundle.
  channel           String   @map("channel")
  // "SENT" | "FAILED" | "SKIPPED_OPT_OUT" | "SKIPPED_NO_EMAIL" | "SKIPPED_TYPE_MUTED" | "SKIPPED_NO_ADDRESS".
  // One row per dispatch ATTEMPT so a retry that succeeds leaves a clear
  // SENT + FAILED trail in audit. Pruning policy: keep 90 days.
  status            String
  providerMessageId String?  @map("provider_message_id")
  errorMessage      String?  @map("error_message")
  sentAt            DateTime @default(now()) @map("sent_at")

  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([employeeId, sentAt])
  @@index([notificationId])
  @@index([status])
  @@map("email_log")
}

model DigestItem {
  id              String   @id @default(uuid())
  digestRunId     String   @map("digest_run_id")
  employeeId      String   @map("employee_id")
  notificationId  String   @map("notification_id")
  includedAt      DateTime @default(now()) @map("included_at")

  digestRun DigestRun @relation(fields: [digestRunId], references: [id], onDelete: Cascade)

  // A notification can only appear in a given digest run once. This is the
  // idempotency guarantee against a re-enqueue race.
  @@unique([digestRunId, notificationId])
  @@index([employeeId, digestRunId])
  @@map("digest_item")
}

model DigestRun {
  id            String    @id @default(uuid())
  employeeId    String    @map("employee_id")
  scheduledFor  DateTime  @map("scheduled_for")            // business-date key (00:00 IST)
  status        String    @default("PENDING")              // "PENDING" | "SENT" | "EMPTY" | "FAILED"
  emailLogId    String?   @unique @map("email_log_id")
  errorMessage  String?   @map("error_message")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  items    DigestItem[]
  emailLog EmailLog?    @relation(fields: [emailLogId], references: [id], onDelete: SetNull)

  // Idempotency: a second cron fire for the same employee + business date
  // is a no-op. The unique constraint races-safe against the digest run
  // creator — Prisma P2002 → caller treats as already-completed.
  @@unique([employeeId, scheduledFor])
  @@index([status])
  @@map("digest_run")
}
