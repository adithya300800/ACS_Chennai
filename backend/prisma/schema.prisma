// SINGLE-TENANT: ACS Chennai employee portal. See TENANCY.md before
// adding any field that scopes by organization/project — every query,
// storage path, OAuth admission, and admin predicate must filter.

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // [B-1] DDL/migration URL. Supabase splits queries (port 6543, transaction
  // pooler) from DDL (port 5432, session pooler) — Prisma's transaction pooler
  // cannot service migration introspection. Both env vars are declared
  // sync: false in render.yaml.
  directUrl = env("DIRECT_DATABASE_URL")
}

model Employee {
  id                     String                  @id @default(uuid())
  email                  String                  @unique
  password               String?
  name                   String
  designation            String?
  department             String?
  isAdmin                Boolean                 @default(false) @map("is_admin")
  // LPR-011 (smallest demonstrable fix): Zoho access + refresh tokens
  // are stored as plaintext columns. A database compromise (lost
  // backup, leaked read replica, SQL injection) hands an attacker the
  // raw ability to call Zoho's APIs as the impersonated employee
  // until Zoho's session TTL or our revoke-all refresh call closes
  // it. The customer-domain allowlist (auth.js ALLOWED_EMAIL_DOMAINS)
  // doesn't help here because the attacker already has the tokens;
  // they don't need to come back through /api/auth/zoho.
  //
  // TODO(LPR-011): encrypt at rest using a managed key (Render env
  // var or KMS). AES-256-GCM with a per-row IV and an AAD bound to
  // the employee id is the minimum acceptable design. Do NOT do that
  // in this commit — it changes the column type, breaks every
  // existing row, and requires a backfill migration. Documenting the
  // gap is the explicit deliverable for LPR-011 in this round.
  zohoAccessToken        String?                 @map("zoho_access_token")
  zohoRefreshToken       String?                 @map("zoho_refresh_token")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  attendance             Attendance[]
  dprSubmitted           DPR[]                   @relation("DPRSubmitter")
  dprReviewed            DPR[]                   @relation("DPRReviewer")
  dprApproved            DPR[]                   @relation("DPRApprover")
  inspectionSubmitted    InspectionRecord[]      @relation("InspectionSubmitter")
  notifications          Notification[]
  leaveRequests          LeaveRequest[]          @relation("LeaveSubmitter")
  leaveReviewed          LeaveRequest[]          @relation("LeaveReviewer")
  trainingCoursesCreated TrainingCourse[]        @relation("CourseCreatedBy")
  trainingEnrollments    TrainingEnrollment[]    @relation("EnrollEmployee")
  trainingAssignedByMe   TrainingEnrollment[]    @relation("EnrollAssignedBy")
  // N17: back-relation for Project.createdBy — projects admin-curated
  // through the dashboard. SetNull on the FK (see Project model notes),
  // so a deleted admin does not delete the projects they created.
  projectsCreated        Project[]               @relation("ProjectCreator")
  // Round-25: email notification preferences + audit log + digest runs.
  // NotificationPreference is 1:1 (PK = employeeId); EmailLog / DigestRun
  // are 1:N and outlive notification rows via onDelete: SetNull.
  notificationPreference NotificationPreference?
  emailLogs              EmailLog[]
  digestRuns             DigestRun[]
  // [REPORT-S3-11] Admin-targeted daily attendance digest bookkeeping.
  // Mirrors DigestRun's (employeeId, scheduledFor) idempotency contract
  // for the admin recipient: a second cron fire on the same date is a
  // no-op. See src/routes/internal-admin-attendance.js header for the
  // claim/update pattern + the P2002 catch race-safety.
  adminDigestRuns        AdminDigestRun[]
  uploadIntents          UploadIntent[]
  // N5 cube-test integration: back-relation to CubeTest.submittedById so
  // the Prisma validator accepts the relation on CubeTest.
  cubeTestsSubmitted     CubeTest[]              @relation("CubeTestSubmitter")
  // N7 (round-28): back-relation for BOQ items this employee created.
  // boqsCreated is for audit ("who added item 2.3.1?") — the create-time
  // audit trail. Mirror with the inspect/dpr back-relations above so the
  // prisma client offers the navigation in both directions.
  boqsCreated            BoqItem[]               @relation("BoqCreator")

  @@map("employees")
}

// ─────────────────────────────────────────────
// Session revocation (Round-20 / DR-005)
// ─────────────────────────────────────────────
// Before DR-005 logout wrote the access-token `jti` to a process-local Map
// that requireAuth never consulted, so "sign out" revoked nothing at all —
// and refresh tokens were pure stateless JWTs, valid for their full 7 days
// even after logout. Both facts are now backed by rows in this database, so
// revocation survives a Render restart / redeploy.
//
// Deliberately NOT related (`@relation`) to Employee:
//   - a revocation record must outlive the employee row it refers to
//     (deleting an employee must never resurrect their live tokens via a
//     cascade), and
//   - the auth middleware reads these on the hot path by primary key only;
//     it never needs to join to `employees`.
// `employeeId` is therefore a plain column kept for audit/bulk-revoke, not
// an FK. Both tables are prunable by `expiresAt` (see lib/revocation.js
// pruneExpired) because a row is worthless once the token it denies has
// expired on its own.

model RevokedToken {
  // The access token's `jti` claim — 128 bits of crypto randomness, so it is
  // the natural primary key. One row == one access token that must be refused.
  jti        String   @id
  employeeId String   @map("employee_id")
  revokedAt  DateTime @default(now()) @map("revoked_at")
  // Mirrors the JWT `exp` claim (converted from seconds to a timestamp) so the
  // pruner can delete rows that can no longer deny anything.
  expiresAt  DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("revoked_token")
}

model RefreshToken {
  id String @id @default(uuid())

  employeeId String @map("employee_id")
  // sha256(refresh JWT). We store the DIGEST, never the token: a read-only
  // leak of this table (SQL injection, stray backup, support query) must not
  // hand out usable 7-day credentials.
  tokenHash  String @unique @map("token_hash")

  createdAt     DateTime  @default(now()) @map("created_at")
  // Rotation chain: points at the row this token replaced. Lets an operator
  // walk a session's history and lets the reuse-detection path prove that a
  // replayed token really was superseded rather than forged.
  rotatedFromId String?   @map("rotated_from_id")
  expiresAt     DateTime  @map("expires_at")
  // Non-null == spent (rotated) or explicitly killed (logout / theft
  // response). Presenting a row that already has `revokedAt` set is the
  // reuse signal that nukes every session for the employee.
  revokedAt     DateTime? @map("revoked_at")
  lastUsedAt    DateTime? @map("last_used_at")

  @@index([employeeId])
  @@index([expiresAt])
  @@map("refresh_token")
}

model Attendance {
  id         String              @id @default(uuid())
  employeeId String              @map("employee_id")
  date       DateTime            @db.Date
  status     String              @default("Present")
  notes      String?
  createdAt  DateTime            @default(now()) @map("created_at")
  employee   Employee            @relation(fields: [employeeId], references: [id])
  sessions   AttendanceSession[]

  @@unique([employeeId, date])
  // Round-7: admin attendance dashboard queries by month (`WHERE date BETWEEN ...`)
  // without this index the dashboard hits a sequential scan once the table grows.
  @@index([date])
  @@map("attendance")
}

model AttendanceSession {
  id           String     @id @default(uuid())
  attendanceId String     @map("attendance_id")
  checkIn      DateTime   @map("check_in")
  checkInLat   Decimal?   @map("check_in_lat") @db.Decimal(10, 7)
  checkInLng   Decimal?   @map("check_in_lng") @db.Decimal(10, 7)
  checkInAddr  String?    @map("check_in_addr")
  checkOut     DateTime?  @map("check_out")
  checkOutLat  Decimal?   @map("check_out_lat") @db.Decimal(10, 7)
  checkOutLng  Decimal?   @map("check_out_lng") @db.Decimal(10, 7)
  checkOutAddr String?    @map("check_out_addr")
  createdAt    DateTime   @default(now()) @map("created_at")
  attendance   Attendance @relation(fields: [attendanceId], references: [id])

  // Round-13: attendanceId used by every session list query under an attendance row.
  // Without this index, the timesheet exporter's per-row session fetch hits a seq scan.
  @@index([attendanceId])
  @@map("attendance_sessions")
}

// ─────────────────────────────────────────────
// DPR Module
// ─────────────────────────────────────────────

enum DPRStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model DPR {
  id                       String    @id @default(uuid())
  projectName              String
  location                 String
  reportDate               DateTime  @db.Date
  weather                  String?
  temperature              String?
  contractor               String?
  workType                 String    @default("MATERIAL_RECEIPT")
  notes                    String?
  // Round-12 DPR refactor: 5 daily-narrative fields requested by the PMC
  // domain review (work executed / location / manpower / risks / materials
  // summary) + a customSections JSON blob for the user's ad-hoc text + table
  // blocks added via the "+" button. workEntries is kept (nullable, deprecated)
  // so old DPRs render without a migration step.
  workExecutedToday        String?   @map("work_executed_today")
  workLocation             String?   @map("work_location")
  manpowerSummary          String?   @map("manpower_summary")
  risksHindrances          String?   @map("risks_hindrances")
  materialsReceivedSummary String?   @map("materials_received_summary")
  customSections           Json?     @map("custom_sections")
  workEntries              Json?
  status                   DPRStatus @default(DRAFT)
  version                  Int       @default(1)
  submittedById            String    @map("submitted_by_id")
  reviewedById             String?   @map("reviewed_by_id")
  approvedById             String?   @map("approved_by_id")
  submittedAt              DateTime? @map("submitted_at")
  reviewedAt               DateTime? @map("reviewed_at")
  approvedAt               DateTime? @map("approved_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  submittedBy   Employee           @relation("DPRSubmitter", fields: [submittedById], references: [id])
  reviewedBy    Employee?          @relation("DPRReviewer", fields: [reviewedById], references: [id])
  approvedBy    Employee?          @relation("DPRApprover", fields: [approvedById], references: [id])
  photos        DPRPhoto[]
  revisions     DPRRevision[]
  notifications Notification[]
  inspections   InspectionRecord[]
  // N5 cube-test integration: a concrete-pour DPR can have multiple cube
  // tests attached (one per cube-cast set). Nullable FK on CubeTest so
  // cubes filed standalone (no parent pour row) still work — see
  // CubeTest.dprId docs.
  cubeTests     CubeTest[]
  // N7 (round-28): BOQ link. Nullable FK to BoqItem so a DPR line can be
  // traced back to its bill-of-quantities item without requiring a full
  // Project Master (the projectName column stays free-text for now).
  // onDelete: SetNull so archiving a BOQ item doesn't cascade-delete the
  // historic DPR rows that referenced it (the audit trail survives).
  boqItemId     String?            @map("boq_item_id")
  boqItem       BoqItem?           @relation(fields: [boqItemId], references: [id], onDelete: SetNull)
  // [N1] Project FK. Nullable so legacy rows from the free-text era stay
  // valid (the migration backfills by case-insensitive name match; rows
  // with no curated match keep projectId=NULL and continue to resolve
  // via projectName). The free-text `projectName` column is kept
  // denormalized (the create payload writes both columns from the same
  // resolved row) so admin KPI roll-ups that still group by name keep
  // working without a parallel migration.
  projectId     String?            @map("project_id")
  project       Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([submittedById, reportDate])
  @@index([reportDate, id])
  @@index([boqItemId])
  @@index([projectId])
  @@map("dpr")
}

model DPRPhoto {
  id          String    @id @default(uuid())
  dprId       String    @map("dpr_id")
  ulid        String
  container   String
  filename    String
  contentType String    @map("content_type")
  sizeBytes   Int       @map("size_bytes")
  caption     String?
  location    String?
  takenAt     DateTime? @map("taken_at")
  uploadedAt  DateTime  @default(now()) @map("uploaded_at")

  dpr DPR @relation(fields: [dprId], references: [id], onDelete: Cascade)

  // Round-7: dprId used in every DPR detail query (joins) — without this
  // index each GET /api/dpr/:id hits a seq scan on dpr_photo. ulid is
  // queried by the orphan-blob cleanup job and by PATCH confirm-upload.
  @@index([dprId])
  @@index([ulid])
  @@map("dpr_photo")
}

model DPRRevision {
  id          String   @id @default(uuid())
  dprId       String   @map("dpr_id")
  version     Int
  snapshot    Json
  changedAt   DateTime @default(now()) @map("changed_at")
  changedById String   @map("changed_by_id")

  dpr DPR @relation(fields: [dprId], references: [id], onDelete: Cascade)

  @@unique([dprId, version])
  // Round-7: revision list reads by dprId + ordering by changedAt; without
  // this index the audit trail read on /api/dpr/:id history hits a seq scan.
  @@index([dprId, changedAt])
  @@map("dpr_revision")
}

// ─────────────────────────────────────────────
// Inspection & Compliance Records Module (Round-12)
// ─────────────────────────────────────────────
// 15 sub-work types (material / cube / water / waterproofing / villa / day-
// activity / NCR / safety / major_deviation) used to live as nested rows
// inside DPR.workEntries. They are now first-class records that:
//   - FK to a DPR (nullable — for filings on Sundays / holidays)
//   - carry their own photos (DPR photos stay on the DPR)
//   - can be filtered by date range, project, type, severity, status
// inspectionType is the SUB_WORK_TYPE_OPTIONS value (e.g. 'material_inspection',
// 'cube_casting', 'ncr', 'safety_violation'). The structured field payload per
// type lives in WORK_TYPE_FIELDS (frontend/src/pages/portal/DprWorkTypes.jsx)
// and is stored as JSON in `data` for forward compatibility.

model InspectionRecord {
  id             String   @id @default(uuid())
  projectName    String
  location       String
  reportDate     DateTime @db.Date
  weather        String?
  contractor     String?
  dprId          String?  @map("dpr_id")
  inspectionType String   @map("inspection_type")
  data           Json
  status         String   @default("OPEN")
  // severity is meaningful for NCR / safety_violation / major_deviation;
  // null for routine inspections (material receipt, cube test, etc.).
  severity       String?
  submittedById  String   @map("submitted_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  dpr         DPR?              @relation(fields: [dprId], references: [id])
  submittedBy Employee          @relation("InspectionSubmitter", fields: [submittedById], references: [id])
  photos      InspectionPhoto[]
  // N5 cube-test integration: a cube_casting inspection is the source of
  // truth for the cast event (when, where, mix design). One inspection can
  // produce multiple cube-test rows (e.g. separate M30 + M40 sets in one
  // pour). OnDelete SetNull so deleting the parent inspection does not
  // orphan the cube-test history.
  cubeTests   CubeTest[]
  // N7 (round-28): BOQ link — same shape as DPR. Nullable FK with SetNull
  // so archiving a BOQ item doesn't cascade-delete historic inspections.
  boqItemId   String?           @map("boq_item_id")
  boqItem     BoqItem?          @relation(fields: [boqItemId], references: [id], onDelete: SetNull)
  // [N1] Project FK. Same shape + rationale as DPR.projectId — nullable
  // for legacy rows that never had a curated Project match, the free-text
  // `projectName` column is kept denormalized so admin KPI roll-ups keep
  // working without a parallel migration.
  projectId   String?           @map("project_id")
  project     Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Indexes mirror DPR's pattern: owner + date for "my inspections this week",
  // dprId for "show me inspections on this DPR", and (date,id) for cursor
  // pagination in list views.
  @@index([submittedById, reportDate])
  @@index([dprId])
  @@index([reportDate, id])
  @@index([inspectionType])
  @@index([boqItemId])
  @@index([projectId])
  @@map("inspection_record")
}

model InspectionPhoto {
  id           String    @id @default(uuid())
  inspectionId String    @map("inspection_id")
  ulid         String
  container    String
  filename     String
  contentType  String    @map("content_type")
  sizeBytes    Int       @map("size_bytes")
  caption      String?
  location     String?
  takenAt      DateTime? @map("taken_at")
  uploadedAt   DateTime  @default(now()) @map("uploaded_at")

  inspection InspectionRecord @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@index([ulid])
  @@map("inspection_photo")
}

// ─────────────────────────────────────────────
// N7 (round-28) — Bill of Quantities (BOQ) line items
// ─────────────────────────────────────────────
//
// Half-step to N1 (Project Master). Lets a DPR / Inspection record link
// back to a specific bill-of-quantities item so the billing engineer can
// trace what was actually executed on-site against the contract quantity.
//
// projectName is free-text (mirrors DPR.projectName / InspectionRecord.
// projectName) because a full Project Master does not exist yet — the FK
// to Project is a deliberate gap, NOT an oversight. When N1 ships, swap
// projectName for a `projectId` FK and a separate BOQ-by-project
// uniqueness rule.
//
// itemCode is the BOQ convention (e.g. "2.3.1", "5.4.2.1") and must be
// unique per projectName so a contractor's "Steel reinforcement — 12mm
// dia — Fe500D" cannot be entered twice under the same project. The
// @@unique lets a 400 DUPLICATE surface cleanly via the Prisma error
// mapper (errors.js:mapPrismaError).
//
// quantity × rate is stored pre-computed in `amount` so variance reports
// don't need to JOIN another table; the computed column is a
// convenience, NOT the source of truth — server-side routes always
// recompute from quantity × rate on write.
//
// isActive is the soft-delete flag — DELETE /api/boq/:id sets
// isActive=false rather than removing the row, because DPR / Inspection
// records keep a FK reference and the audit trail must survive.
//
// createdById is the Employee who added the item. PATCH/DELETE permit
// either the creator or an admin (mirrors DPR ownership model).
//
// onDelete: Restrict on the Employee FK — deleting an employee must not
// orphan a BOQ row, and an admin transfer-out flow can reassign createdBy
// if needed (out of scope for this round).
model BoqItem {
  id          String   @id @default(uuid())
  // [Phase-4 #2 hot-fix] added @map for snake_case columns. Pre-fix
  // Prisma queried `"projectName"` / `"itemCode"` (camelCase — the field
  // name) and the live DB rejects those queries with P2022 "column does
  // not exist", because the migration in 20260905020000_n7_boq_items
  // intentionally created the columns as `project_name` / `item_code`
  // to match the model convention used by DPR / InspectionRecord. DB
  // schema is unchanged — these annotations are client-side only — so no
  // migration is needed. `prisma migrate status` will continue to see
  // 0 pending. The other columns (description / unit / quantity / rate /
  // amount / category) happen to be word-identical in camelCase and
  // snake_case, so they don't need @map, but adding for consistency.
  projectName String   @map("project_name")
  itemCode    String   @map("item_code") @db.VarChar(60)
  description String   @map("description")
  unit        String   @map("unit") @db.VarChar(20)
  quantity    Float    @map("quantity")
  rate        Float    @map("rate")
  // computed (quantity × rate) — convenience, not source of truth
  amount      Float    @map("amount")
  category    String?  @map("category") @db.VarChar(60)
  isActive    Boolean  @default(true) @map("is_active")
  // [N1] Project FK. Nullable so legacy rows that never had a curated
  // Project match stay valid; the free-text projectName column is kept
  // denormalized so the variance report keeps working without a parallel
  // migration. The unique constraint is rebuilt on (projectId, itemCode)
  // — NULLS DISTINCT so multiple legacy rows with projectId=NULL + same
  // itemCode do not collide. Note the old unique was (projectName,
  // itemCode); the migration drops it explicitly.
  projectId   String?  @map("project_id")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy   Employee           @relation("BoqCreator", fields: [createdById], references: [id], onDelete: Restrict)
  dprs        DPR[]
  inspections InspectionRecord[]
  project     Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([projectId, itemCode])
  @@index([projectName])
  @@index([isActive])
  @@index([projectId])
  @@map("boq_item")
}

model Notification {
  id                   String   @id @default(uuid())
  employeeId           String   @map("employee_id")
  type                 String
  dprId                String?  @map("dpr_id")
  leaveRequestId       String?  @map("leave_request_id")
  trainingEnrollmentId String?  @map("training_enrollment_id")
  message              String
  isRead               Boolean  @default(false) @map("is_read")
  createdAt            DateTime @default(now()) @map("created_at")

  employee           Employee            @relation(fields: [employeeId], references: [id])
  dpr                DPR?                @relation(fields: [dprId], references: [id])
  leaveRequest       LeaveRequest?       @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)
  trainingEnrollment TrainingEnrollment? @relation(fields: [trainingEnrollmentId], references: [id], onDelete: SetNull)
  // Round-25: back-relation to the email audit log. SetNull so a notification
  // row can be pruned without orphaning the audit history of who got the email.
  emailLogs          EmailLog[]

  @@index([employeeId, createdAt])
  // Round-7: dpr relation is included in many read queries; index for joins.
  @@index([dprId])
  // Round-13: leave notifications join through leaveRequestId on the bell feed.
  @@index([leaveRequestId])
  // Round-14 (training module): training notifications join through
  // trainingEnrollmentId on the bell feed; mirror the leaveRequestId pattern.
  @@index([trainingEnrollmentId])
  @@map("notification")
}

// ─────────────────────────────────────────────
// Leave Request Module (Round-13)
// ─────────────────────────────────────────────
// Standard leave request workflow:
//   1. Employee submits POST /api/leave (status=PENDING).
//   2. Admin reviews via /portal/admin/leave; approve or reject
//      (status → APPROVED / REJECTED, with reviewedById/reviewedAt set).
//   3. Employee may cancel a PENDING request (status → CANCELLED).
//
// LeaveType is a string validated server-side (not an enum) so adding new
// leave categories (e.g. MATERNITY, COMP_OFF) is a non-migration change.
//
// Future extensibility hooks baked in:
//   - `metadata Json?` — for attachments, half-day flags, custom HR policies
//   - `cancelledAt` + `reviewNotes` columns present from day 1 so audit flows
//     in v2 don't need a schema migration.
//   - No `dayCount` column (holiday/weekend policy changes don't require
//     backfill).
//
// Indexes chosen for the hot reads:
//   - employee dashboard "my recent leave" → (employeeId, startDate)
//   - admin queue "pending leave oldest first" → (status, startDate)

model LeaveRequest {
  id           String    @id @default(uuid())
  employeeId   String    @map("employee_id")
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  leaveType    String    @default("CASUAL") @map("leave_type")
  reason       String
  status       String    @default("PENDING")
  reviewedById String?   @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewNotes  String?   @map("review_notes")
  cancelledAt  DateTime? @map("cancelled_at")
  metadata     Json?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  employee      Employee       @relation("LeaveSubmitter", fields: [employeeId], references: [id])
  reviewedBy    Employee?      @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  notifications Notification[]

  @@index([employeeId, startDate])
  @@index([status, startDate])
  @@index([startDate, endDate])
  @@map("leave_request")
}

// ─────────────────────────────────────────────
// Employee Training Module (Round-14)
// ─────────────────────────────────────────────
// Admin assigns external training courses (LinkedIn Learning, Coursera,
// Udemy, YouTube, Vimeo, etc.) to one or more employees at once. Employees
// watch the course embedded in the portal; the player captures watch
// progress via the YouTube / Vimeo IFrame APIs and PATCHes it back to the
// server every ~10s. Status auto-flips to COMPLETED when the player's
// `ended` event fires (progress >= 100).
//
// Single video per course in v1 — adding multi-lesson courses later is a
// purely additive schema change (insert a TrainingLesson table with a
// `(courseId, order)` unique key and roll progress up from lessons to the
// parent enrollment).
//
// Notification model gained a `trainingEnrollmentId` FK so the bell feed
// shows "You have a new training: …" / "Training completed: …" entries
// alongside the existing DPR + leave notifications.
//
// Indexes chosen for the hot reads:
//   - employee "My Learning" hub → (employeeId, status)
//   - admin dashboard "pending-by-status + due date" → (status, dueDate)
//   - admin course catalog "active courses newest first" → (isArchived, createdAt)

enum TrainingProvider {
  YOUTUBE
  VIMEO
  LINKEDIN_LEARNING
  COURSERA
  UDEMY
  OTHER
}

// Round-20 (DR-010): evidence provenance. The previous `COMPLETED` value
// collapsed four distinct completion paths (self-attest, player, provider
// webhook, admin override) into one indistinguishable terminal state, so
// the admin UI could not tell a watched-to-end course from a one-click
// attestation. Split into four explicit completed-states — each carries a
// matching `evidenceClass` string for filtering/reporting and an optional
// `completedBy` actor id. OVERDUE and CANCELLED are bookkeeping states for
// admin operations (cron / bulk-cancel) — not user-driven in v1.
enum TrainingEnrollmentStatus {
  ASSIGNED // not yet started
  IN_PROGRESS // watched > 0% and < 100%
  SELF_ATTESTED_COMPLETED // employee clicked "I'm done" (no player data)
  PLAYER_OBSERVED_COMPLETED // YouTube/Vimeo IFrame ended=true event
  PROVIDER_VERIFIED_COMPLETED // future: Coursera/Udemy webhook confirmation
  ADMIN_OVERRIDE_COMPLETED // admin clicked override on employee's behalf
  OVERDUE // past dueDate + not completed (admin/cron)
  CANCELLED // admin cancelled the assignment
}

enum TrainingPriority {
  LOW
  NORMAL
  HIGH
}

model TrainingCourse {
  id           String           @id @default(uuid())
  title        String           @db.VarChar(160)
  description  String?
  externalUrl  String           @map("external_url") @db.VarChar(2048)
  provider     TrainingProvider
  category     String?          @db.VarChar(60)
  durationHint Int?             @map("duration_hint")
  isArchived   Boolean          @default(false) @map("is_archived")
  createdById  String           @map("created_by_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  createdBy   Employee             @relation("CourseCreatedBy", fields: [createdById], references: [id])
  enrollments TrainingEnrollment[]

  @@index([isArchived, createdAt])
  @@index([provider])
  @@map("training_course")
}

model TrainingEnrollment {
  id                String                   @id @default(uuid())
  courseId          String                   @map("course_id")
  employeeId        String                   @map("employee_id")
  assignedById      String                   @map("assigned_by_id")
  assignedAt        DateTime                 @default(now()) @map("assigned_at")
  dueDate           DateTime?                @map("due_date") @db.Date
  priority          TrainingPriority         @default(NORMAL)
  status            TrainingEnrollmentStatus @default(ASSIGNED)
  progressPct       Int                      @default(0) @map("progress_pct")
  lastWatchedSec    Int                      @default(0) @map("last_watched_sec")
  startedAt         DateTime?                @map("started_at")
  // Round-20 (DR-010): separate from updatedAt so the actual completion
  // instant is queryable; null until the enrollment hits a completed-state.
  completedAt       DateTime?                @map("completed_at")
  // Round-20 (DR-010) evidence provenance — one of SELF_ATTESTED |
  // PLAYER_OBSERVED | PROVIDER_VERIFIED | ADMIN_OVERRIDE. Null until
  // the enrollment is completed; matches status suffix (SELF_ATTESTED ↔
  // SELF_ATTESTED_COMPLETED, etc.) so reports can GROUP BY either column.
  evidenceClass     String?                  @map("evidence_class") @db.VarChar(40)
  // Actor who flipped the row to a completed-state. Equals employeeId for
  // SELF_ATTESTED, a watching session for PLAYER_OBSERVED (still the
  // employee's own row, but recorded for audit), or an admin id for
  // ADMIN_OVERRIDE. Null while the enrollment is open.
  completedBy       String?                  @map("completed_by")
  // Player session payload / provider webhook payload (claim position, claimed
  // watch duration, raw player event timestamp). Used for audit and to
  // defend the auto-complete against a fake `ended=true` from a tampered
  // client. Json? so the schema doesn't pin us to a provider's field shape.
  evidenceMetadata  Json?                    @map("evidence_metadata")
  // Future provider webhook id (Coursera/Udemy completion id, etc.) so we
  // can reconcile duplicate webhooks against the original enrollment row.
  providerSessionId String?                  @map("provider_session_id") @db.VarChar(120)
  employeeNote      String?                  @map("employee_note") @db.VarChar(500)
  // [S3-6] Last successful admin-notification attempt for this enrollment
  // (any status where fan-out delivered to at least one admin). Distinct
  // from updatedAt so the retry pass can find rows that flipped to
  // OVERDUE but never got notified (e.g. Resend outage at 00:30 IST) and
  // re-attempt the fan-out without re-flipping. Null until first success.
  overdueNotifiedAt DateTime?                @map("overdue_notified_at")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  course        TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employee      Employee       @relation("EnrollEmployee", fields: [employeeId], references: [id])
  assignedBy    Employee       @relation("EnrollAssignedBy", fields: [assignedById], references: [id])
  notifications Notification[]

  // A given employee can only have one enrollment per course — bulk-assign
  // is idempotent on this pair (existing row is reused if present).
  @@unique([courseId, employeeId])
  @@index([employeeId, status])
  @@index([status, dueDate])
  @@index([assignedAt])
  // Round-20: completion reports filter by evidenceClass; partial index
  // keeps it tight (only completed rows have an evidenceClass value).
  @@index([evidenceClass])
  @@map("training_enrollment")
}

// ─────────────────────────────────────────────
// Round-25: Email Notification System
// ─────────────────────────────────────────────
//
// Four new tables power the transactional-email transport added alongside the
// existing in-app SSE feed (Notification table is unchanged). The split keeps
// each layer's data minimal and indexable for its own hot path:
//
//   - NotificationPreference (1:1 with Employee, PK = employeeId) — per-user
//     switches. emailEnabled is the master kill switch; digestEnabled opts
//     out of the daily digest (still receives immediate emails); typeMutes
//     blocks specific notification types entirely. digestHourLocal captures
//     the user's preferred send hour (0-23, IST) for the daily digest.
//
//   - EmailLog — append-only audit trail for every email dispatch attempt
//     (sent, failed, opted-out, missing-address). notificationId is SetNull
//     so a notification row can be pruned without orphaning the audit.
//
//   - DigestRun + DigestItem — book-keeping for the daily digest cron. The
//     @@unique([employeeId, scheduledFor]) is the idempotency key: a second
//     cron fire on the same day is a no-op. DigestItem records which
//     notifications were bundled into a given run.

model NotificationPreference {
  employeeId      String   @id @map("employee_id")
  emailEnabled    Boolean  @default(true) @map("email_enabled")
  digestEnabled   Boolean  @default(true) @map("digest_enabled")
  // Free-form JSON object: { "<NOTIFICATION_TYPE>": true }. Reads tolerate
  // unknown type strings (forward-compat) and missing keys (default = false,
  // i.e. NOT muted).
  typeMutes       Json     @default("{}") @map("type_mutes")
  // 0-23, default 8 AM IST. Out-of-range values are rejected at the API
  // layer; the cron uses Date.now() in TZ=Asia/Kolkata for the actual send
  // window matching.
  digestHourLocal Int      @default(8) @map("digest_hour_local")
  updatedAt       DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("notification_preference")
}

model EmailLog {
  id                String   @id @default(uuid())
  employeeId        String   @map("employee_id")
  notificationId    String?  @map("notification_id")
  recipientEmail    String   @map("recipient_email")
  subject           String
  // "IMMEDIATE" — single employee notification email.
  // "DIGEST" — daily employee digest bundle.
  // "ADMIN_IMMEDIATE" — round-26: admin-targeted immediate (DPR submit, inspection open,
  //   leave request, training overdue). One row per admin recipient.
  // "ADMIN_DIGEST" — round-26: admin-targeted daily attendance digest (7 PM IST).
  // The column is a free-form String so adding new values is a no-op migration.
  channel           String   @map("channel")
  // "SENT" | "FAILED" | "SKIPPED_OPT_OUT" | "SKIPPED_NO_EMAIL" | "SKIPPED_TYPE_MUTED" | "SKIPPED_NO_ADDRESS".
  // One row per dispatch ATTEMPT so a retry that succeeds leaves a clear
  // SENT + FAILED trail in audit. Pruning policy: keep 90 days.
  status            String
  providerMessageId String?  @map("provider_message_id")
  errorMessage      String?  @map("error_message")
  sentAt            DateTime @default(now()) @map("sent_at")

  employee       Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  notification   Notification?   @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  // Back-relation required by Prisma's validation when DigestRun declares
  // `emailLog EmailLog? @relation(...)` on the other side. Optional because
  // emailLogId is nullable + @unique — at most one DigestRun points at this
  // email log row (e.g. when the digest send succeeds and gets audited).
  digestRun      DigestRun?
  // [REPORT-S3-11] AdminDigestRun mirrors the same nullable + @unique
  // contract as DigestRun above: at most one admin-digest-run can point
  // at any given EmailLog row. SetNull mirrors digest_run's behaviour so
  // pruning audit rows does not orphan the bookkeeping.
  adminDigestRun AdminDigestRun?

  @@index([employeeId, sentAt])
  @@index([notificationId])
  @@index([status])
  @@map("email_log")
}

model DigestItem {
  id             String   @id @default(uuid())
  digestRunId    String   @map("digest_run_id")
  employeeId     String   @map("employee_id")
  notificationId String   @map("notification_id")
  includedAt     DateTime @default(now()) @map("included_at")

  digestRun DigestRun @relation(fields: [digestRunId], references: [id], onDelete: Cascade)

  // A notification can only appear in a given digest run once. This is the
  // idempotency guarantee against a re-enqueue race.
  @@unique([digestRunId, notificationId])
  @@index([employeeId, digestRunId])
  @@map("digest_item")
}

model DigestRun {
  id           String    @id @default(uuid())
  employeeId   String    @map("employee_id")
  scheduledFor DateTime  @map("scheduled_for") // business-date key (00:00 IST)
  status       String    @default("PENDING") // "PENDING" | "SENT" | "EMPTY" | "FAILED"
  emailLogId   String?   @unique @map("email_log_id")
  errorMessage String?   @map("error_message")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  items    DigestItem[]
  emailLog EmailLog?    @relation(fields: [emailLogId], references: [id], onDelete: SetNull)

  // Idempotency: a second cron fire for the same employee + business date
  // is a no-op. The unique constraint races-safe against the digest run
  // creator — Prisma P2002 → caller treats as already-completed.
  @@unique([employeeId, scheduledFor])
  @@index([status])
  @@map("digest_run")
}

// [REPORT-S3-11] Admin-targeted daily attendance digest bookkeeping.
//
// The admin attendance digest cron
// (POST /api/internal/attendance/digest/run) hands every active admin a
// single email summarising present / on-leave / absent for the target
// date. The handler previously had no application-layer idempotency: any
// manual re-fire via workflow_dispatch re-sent the digest to every
// admin, because nothing pinned a "we already sent this admin the
// digest for date X" record.
//
// AdminDigestRun is the admin-recipient analogue of DigestRun. One row
// per (admin, scheduledFor); the @@unique constraint is the idempotency
// key — Prisma P2002 → caller treats as already-claimed and short-
// circuits the per-admin send block entirely.
//
// Lifecycle:
//   PENDING               — claimed by an in-flight fire (created with status='PENDING').
//   SENT                  — email dispatch succeeded (result.ok === true).
//   SKIPPED_OPT_OUT       — admin has emailEnabled=false (master kill switch).
//   SKIPPED_TYPE_MUTED    — admin muted ADMIN_ATTENDANCE_DAILY.
//   SKIPPED_NO_ADDRESS    — admin row has no email address.
//   FAILED                — sendEmail returned ok:false (transport / 4xx / 5xx).
//
// Cleanup is intentionally NOT scoped to this PR (a future round adds a
// 90-day prune sweep). The volume is bounded: 1 row per admin per date —
// for a single-tenant deployment with O(10) admins and O(365) days of
// retention, the table never exceeds O(3650) rows.
model AdminDigestRun {
  id           String   @id @default(uuid())
  adminId      String   @map("admin_id")
  scheduledFor DateTime @map("scheduled_for") // business-date key (00:00 IST)
  status       String   @default("PENDING") // PENDING | SENT | SKIPPED_OPT_OUT | SKIPPED_TYPE_MUTED | SKIPPED_NO_ADDRESS | FAILED
  // One AdminDigestRun → one EmailLog (the audit row written by the
  // handler). Nullable + @unique mirrors DigestRun.emailLogId so the
  // optional relation is well-formed.
  emailLogId   String?  @unique @map("email_log_id")
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")

  admin    Employee  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  emailLog EmailLog? @relation(fields: [emailLogId], references: [id], onDelete: SetNull)

  // Idempotency: a second cron fire for the same admin + business date
  // is a no-op. The unique constraint races-safe against the per-admin
  // claim — Prisma P2002 → caller treats as already-claimed.
  @@unique([adminId, scheduledFor])
  @@index([scheduledFor])
  @@map("admin_digest_run")
}

// ─────────────────────────────────────────────────────────────────────────────
// LPR-012 (round-26): UploadIntent — durable record of a presigned-upload
// handshake.
//
// Before round-26, upload intents lived in a process-local Map
// (`pendingUploads` in src/lib/uploadRoutes.js). That worked for a single
// Render instance but meant:
//   - Intent could be lost on a process restart mid-upload
//   - Multi-instance horizontal scale could not share the registry
//   - There was no audit trail of who attempted which upload
//   - Foreign-employee confirmation was enforced only by Map lookup
//
// UploadIntent persists the (employeeId, ulid) pair, the scoped blob path,
// and the lifecycle (PENDING → CONFIRMED | EXPIRED). /sas-url writes the
// intent BEFORE returning the presigned URL; /confirm-upload validates
// ownership and marks the intent CONFIRMED inside the same transaction
// that consumes the upload (so a confirm can never orphan an intent).
//
// The in-process pendingUploads Map still exists as a hot-path cache for
// the 20-min TTL sweep — the DB row is the source of truth.
// ─────────────────────────────────────────────────────────────────────────────
model UploadIntent {
  id          String    @id @default(uuid())
  employeeId  String    @map("employee_id")
  ulid        String    @map("ulid")
  container   String    @map("container")
  blobPath    String    @map("blob_path")
  contentType String    @map("content_type")
  status      String    @default("PENDING") @map("status") // PENDING | CONFIRMED | EXPIRED
  expiresAt   DateTime  @map("expires_at")
  confirmedAt DateTime? @map("confirmed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  // [S3-7] Binding columns — the missing half of LPR-012.
  //
  // LPR-012 built the registry but nothing ever CONSUMED it: the DPR and
  // Inspection POST handlers attached photos straight from the client
  // array without reading, validating, or consuming the intent. A
  // CONFIRMED intent whose DPR was never posted therefore became a
  // permanent orphan (the LPR-012 sweep deliberately skipped CONFIRMED
  // rows), and a client could POST a photo whose ulid had no intent at
  // all — only the regex shape was checked.
  //
  // `boundType` records WHICH business record consumed the blob:
  //   'dpr'        — bound by POST /api/dpr
  //   'inspection' — bound by POST /api/inspection
  //   'swept'      — terminal sentinel written by the sweep's third pass
  //                  after it has verified the blob is gone. It is NOT a
  //                  business binding; it exists so the EXPIRED-cleanup
  //                  pass has a termination condition and does not
  //                  re-scan the same dead rows every 15 minutes forever.
  //
  // `boundAt` is the serialization point between the binder and the
  // sweep: the sweep's CONFIRMED-orphan pass guards on `boundAt IS NULL`,
  // so a DPR POST that binds a row mid-sweep lands as `count = 0` and
  // the blob is left alone.
  boundType String?   @map("bound_type")
  boundAt   DateTime? @map("bound_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // An intent is identified by (employeeId, ulid). Two intents for the
  // same ulid from different employees is impossible because ulid is
  // server-generated AND scoped under employeeId in the blob path —
  // the unique constraint is defence-in-depth.
  @@unique([employeeId, ulid])
  @@index([status, expiresAt])
  @@index([employeeId, status])
  // [S3-7] Drives all three passes of the durable sweep
  // (src/routes/internal-upload-sweep.js):
  //   PENDING-expire      → (status='PENDING')
  //   CONFIRMED-orphan    → (status='CONFIRMED', boundAt IS NULL)
  //   EXPIRED-blob-verify → (status='EXPIRED',   boundAt IS NULL)
  @@index([status, boundAt])
  @@map("upload_intent")
}

// ─────────────────────────────────────────────────────────────────────────────
// N5 (round-29): Cube-test integration — links the cube-casting inspection
// (the CAST event) to the concrete-pour DPR, and tracks the 7-day / 28-day
// compression-test results.
//
// One CubeTest row = one cube set = N cubes cast from one pour on one day,
// tested at 7d (optional, for QA progression check) and 28d (the spec-
// acceptance result). The status enum encodes the lifecycle so a dashboard
// can derive pass/fail without re-comparing result vs expectedStrength on
// every read:
//
//   PENDING                  — cast but no results yet (waiting on 7d/28d)
//   SEVEN_DAY_PASSED         — 7d result recorded, met expectedStrength
//   SEVEN_DAY_FAILED         — 7d result recorded, BELOW expectedStrength
//   TWENTY_EIGHT_DAY_PASSED  — 28d result recorded, met expectedStrength
//   TWENTY_EIGHT_DAY_FAILED  — 28d result recorded, BELOW expectedStrength
//   OVERDUE                  — 28d due-date passed with no result on file
//
// Both castingRecordId (the cube_casting inspection) and dprId (the parent
// pour) are nullable independently:
//   - castingRecordId null  — standalone filing (no inspection row yet)
//   - dprId null            — pour happened without a DPR entry (e.g. Sunday
//                             pour filed retroactively)
//
// Only one inspection per cube set in v1 (a 1:N between inspection and cube
// tests is supported via cubeTests[]) so a single cube-cast inspection can
// spawn multiple cube_test rows when one pour produced multiple grade sets
// (e.g. M30 columns + M40 beams in one slab).
//
// expectedStrength is the mix-design characteristic strength (e.g. 30.0
// for M30). Pass/fail is "result >= expectedStrength" — same formula the
// IS 456 strength-conformance check uses. Per-cube results are not modelled
// at this granularity (a cube "set" is averaged for v1).
// ─────────────────────────────────────────────────────────────────────────────
model CubeTest {
  id                     String    @id @default(uuid())
  // FK to the cube_casting InspectionRecord (the CAST event). Nullable so
  // a standalone filing (no inspection yet) is allowed. SetNull on delete:
  // deleting the inspection should not destroy the cube-test history — the
  // test results are a compliance record that may be referenced by external
  // billing / acceptance paperwork long after the inspection is purged.
  castingRecordId        String?   @map("casting_record_id")
  // FK to the parent DPR (the concrete pour). Nullable for standalone
  // filings. SetNull on delete — same reasoning as above.
  dprId                  String?   @map("dpr_id")
  // Free-text location label (e.g. "Grid A3-B4, Slab Level 2"). Capped at
  // 200 chars by the route handler; column is plain TEXT for forward
  // compatibility with longer multi-line locations.
  pourLocation           String    @map("pour_location")
  // Mix-design grade label (e.g. "M30"). Capped at 40 chars; not normalized
  // because the value-set is small enough to spot-check in code rather than
  // a lookup table.
  concreteGrade          String    @map("concrete_grade")
  // The day the cubes were cast (date only, IST business day).
  castDate               DateTime  @map("cast_date") @db.Date
  // castDate + 7 days, computed on write. Indexed for the 7-day admin
  // dashboard tile.
  sevenDayDueDate        DateTime  @map("seven_day_due_date") @db.Date
  // castDate + 28 days, computed on write. Indexed for the 28-day admin
  // dashboard tile and the /api/cube-tests/due-soon endpoint.
  twentyEightDayDueDate  DateTime  @map("twenty_eight_day_due_date") @db.Date
  // N/mm² at 7d. Null until the lab reports the result. Capped at 200 to
  // reject typos like 3000 N/mm² that a misread decimal could cause.
  sevenDayResult         Float?    @map("seven_day_result")
  // When the 7d test was run. Null until sevenDayResult is set.
  sevenDayTestedAt       DateTime? @map("seven_day_tested_at")
  // N/mm² at 28d. Null until the lab reports the result.
  twentyEightDayResult   Float?    @map("twenty_eight_day_result")
  // When the 28d test was run. Null until twentyEightDayResult is set.
  twentyEightDayTestedAt DateTime? @map("twenty_eight_day_tested_at")
  // Target characteristic strength (e.g. 30.0 for M30). Stored on the row
  // (rather than derived from concreteGrade) so a strength override on a
  // particular pour does not require a code change.
  expectedStrength       Float     @map("expected_strength")
  // Lifecycle state. See the header comment for the value set. Default is
  // PENDING (cast but no tests reported).
  status                 String    @default("PENDING")
  // FK to the employee who filed the cube-test row.
  submittedById          String    @map("submitted_by_id")
  notes                  String?
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  castingRecord InspectionRecord? @relation(fields: [castingRecordId], references: [id], onDelete: SetNull)
  dpr           DPR?              @relation(fields: [dprId], references: [id], onDelete: SetNull)
  submittedBy   Employee          @relation("CubeTestSubmitter", fields: [submittedById], references: [id])

  // Hot reads:
  //   - calendar timeline "what was cast in Sept 2026" → (castDate)
  //   - 28-day compliance dashboard "tests due in next 7 days" →
  //     (twentyEightDayDueDate) [the route filters by status]
  //   - admin queue "all PENDING/SEVEN_DAY_FAILED cubes awaiting action" →
  //     (status)
  // The 7-day due-date index is omitted — admin workflow is dominated by
  // 28-day readings (the spec-acceptance test); 7-day is QA-only and the
  // 28d index covers the cross-due bucket it would need anyway.
  @@index([castDate])
  @@index([twentyEightDayDueDate])
  @@index([status])
  // Pour-summary endpoint: `WHERE dprId = ? GROUP BY status` — the
  // (dprId, status) index makes that an index scan, not a full table read.
  @@index([dprId, status])
  @@map("cube_test")
}

// ─────────────────────────────────────────────────────────────────────────────
// N17 (Project-level dashboard with KPI tiles): lightweight Project master.
//
// Half-step to N1 (full Project module, XL). The dashboard needs a project
// dimension today, so admins can group DPR / Inspection / CubeTest / BOQ
// roll-ups by site, but N1's full scope (RFI, Drawings, BOQ management
// flows, document storage) is out of scope. This model is the minimum
// metadata that lets:
//   1. The admin UI show "this DPR belongs to project T-NAGAR" rather
//      than a bare free-text string.
//   2. The dashboard's KPI endpoint resolve an `idOrName` URL param
//      against a curated row OR fall back to auto-discovering names from
//      existing DPR.projectName values.
//
// `name` is the canonical cross-module identifier — it matches the
// `projectName` column already on DPR / InspectionRecord / BoqItem, so the
// KPI endpoint can do a string match against either source.
//
// `code` is an optional short label for human-readable displays (e.g. on
// admin tables and on PDF exports). It is OPTIONAL and UNIQUE because the
// dashboard must work for projects that have not yet been registered in
// this table (auto-discovered from DPR.projectName).
//
// `isActive` is the soft-delete flag — admin DELETE flips this to false
// rather than removing the row, so historical DPRs that reference the
// project still join correctly.
//
// onDelete: SetNull on createdById — deleting an admin must not orphan a
// project row. The audit trail (name + created_at) is preserved.
// ─────────────────────────────────────────────────────────────────────────────
model Project {
  id              String    @id @default(uuid())
  name            String    @unique
  code            String?   @unique
  client          String?
  location        String?
  // [N1] Phase-A widening. Project now carries the structured metadata
  // the project-anchor page renders (parties, contract value, sites,
  // free-text description). parties and sites are JSONB so the schema
  // doesn't lock the row shape for new party/site fields the PM might
  // add later. contractValue is Decimal(15,2) — same precision the
  // BoqItem.amount column uses so the variance report can compare
  // contract vs executed without a unit-conversion artifact.
  parties         Json?     @map("parties")
  contractValue   Decimal?  @map("contract_value") @db.Decimal(15, 2)
  sites           Json?     @map("sites")
  description     String?   @map("description")
  isActive        Boolean   @default(true) @map("is_active")
  startDate       DateTime? @map("start_date") @db.Date
  expectedEndDate DateTime? @map("expected_end_date") @db.Date
  createdById     String?   @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  createdBy   Employee?          @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  // [N1] Back-relations for the FK swap on DPR / InspectionRecord /
  // BoqItem. The migration creates nullable `project_id` columns on each
  // child with ON DELETE SET NULL, so archiving a Project row preserves
  // historical DPRs / inspections / BOQ lines (their free-text projectName
  // column still resolves the lookup, the FK just stops pointing at a
  // soft-deleted row).
  dprs        DPR[]
  inspections InspectionRecord[]
  boqItems    BoqItem[]

  // Hot read: the KPI list endpoint filters by `isActive = true` so the
  // active-projects dropdown doesn't surface soft-deleted rows. Index is
  // not on `name` because the @unique constraint already creates one.
  @@index([isActive])
  @@map("project")
}
