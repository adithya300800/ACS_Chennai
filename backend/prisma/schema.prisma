// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id               String         @id @default(uuid())
  email            String         @unique
  password         String?
  name             String
  designation      String?
  department       String?
  isAdmin          Boolean        @default(false) @map("is_admin")
  zohoAccessToken  String?        @map("zoho_access_token")
  zohoRefreshToken String?        @map("zoho_refresh_token")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  attendance           Attendance[]
  dprSubmitted         DPR[]                @relation("DPRSubmitter")
  dprReviewed          DPR[]                @relation("DPRReviewer")
  dprApproved          DPR[]                @relation("DPRApprover")
  inspectionSubmitted  InspectionRecord[]   @relation("InspectionSubmitter")
  notifications        Notification[]
  leaveRequests        LeaveRequest[]       @relation("LeaveSubmitter")
  leaveReviewed        LeaveRequest[]       @relation("LeaveReviewer")

  @@map("employees")
}

model Attendance {
  id         String              @id @default(uuid())
  employeeId String              @map("employee_id")
  date       DateTime            @db.Date
  status     String              @default("Present")
  notes      String?
  createdAt  DateTime            @default(now()) @map("created_at")
  employee   Employee            @relation(fields: [employeeId], references: [id])
  sessions   AttendanceSession[]

  @@unique([employeeId, date])
  // Round-7: admin attendance dashboard queries by month (`WHERE date BETWEEN ...`)
  // without this index the dashboard hits a sequential scan once the table grows.
  @@index([date])
  @@map("attendance")
}

model AttendanceSession {
  id           String     @id @default(uuid())
  attendanceId String     @map("attendance_id")
  checkIn      DateTime   @map("check_in")
  checkInLat   Decimal?   @map("check_in_lat") @db.Decimal(10, 7)
  checkInLng   Decimal?   @map("check_in_lng") @db.Decimal(10, 7)
  checkInAddr  String?    @map("check_in_addr")
  checkOut     DateTime?  @map("check_out")
  checkOutLat  Decimal?   @map("check_out_lat") @db.Decimal(10, 7)
  checkOutLng  Decimal?   @map("check_out_lng") @db.Decimal(10, 7)
  checkOutAddr String?    @map("check_out_addr")
  createdAt    DateTime   @default(now()) @map("created_at")
  attendance   Attendance @relation(fields: [attendanceId], references: [id])

  // Round-13: attendanceId used by every session list query under an attendance row.
  // Without this index, the timesheet exporter's per-row session fetch hits a seq scan.
  @@index([attendanceId])
  @@map("attendance_sessions")
}

// ─────────────────────────────────────────────
// DPR Module
// ─────────────────────────────────────────────

enum DPRStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model DPR {
  id                       String    @id @default(uuid())
  projectName              String
  location                 String
  reportDate               DateTime  @db.Date
  weather                  String?
  temperature              String?
  contractor               String?
  workType                 String    @default("MATERIAL_RECEIPT")
  notes                    String?
  // Round-12 DPR refactor: 5 daily-narrative fields requested by the PMC
  // domain review (work executed / location / manpower / risks / materials
  // summary) + a customSections JSON blob for the user's ad-hoc text + table
  // blocks added via the "+" button. workEntries is kept (nullable, deprecated)
  // so old DPRs render without a migration step.
  workExecutedToday        String?   @map("work_executed_today")
  workLocation             String?   @map("work_location")
  manpowerSummary          String?   @map("manpower_summary")
  risksHindrances          String?   @map("risks_hindrances")
  materialsReceivedSummary String?   @map("materials_received_summary")
  customSections           Json?     @map("custom_sections")
  workEntries              Json?
  status                   DPRStatus @default(DRAFT)
  version                  Int       @default(1)
  submittedById            String    @map("submitted_by_id")
  reviewedById             String?   @map("reviewed_by_id")
  approvedById             String?   @map("approved_by_id")
  submittedAt              DateTime? @map("submitted_at")
  reviewedAt               DateTime? @map("reviewed_at")
  approvedAt               DateTime? @map("approved_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  submittedBy   Employee           @relation("DPRSubmitter", fields: [submittedById], references: [id])
  reviewedBy    Employee?          @relation("DPRReviewer", fields: [reviewedById], references: [id])
  approvedBy    Employee?          @relation("DPRApprover", fields: [approvedById], references: [id])
  photos        DPRPhoto[]
  revisions     DPRRevision[]
  notifications Notification[]
  inspections   InspectionRecord[]

  @@unique([submittedById, reportDate])
  @@index([reportDate, id])
  @@map("dpr")
}

model DPRPhoto {
  id          String    @id @default(uuid())
  dprId       String    @map("dpr_id")
  ulid        String
  container   String
  filename    String
  contentType String    @map("content_type")
  sizeBytes   Int       @map("size_bytes")
  caption     String?
  location    String?
  takenAt     DateTime? @map("taken_at")
  uploadedAt  DateTime  @default(now()) @map("uploaded_at")

  dpr DPR @relation(fields: [dprId], references: [id], onDelete: Cascade)

  // Round-7: dprId used in every DPR detail query (joins) — without this
  // index each GET /api/dpr/:id hits a seq scan on dpr_photo. ulid is
  // queried by the orphan-blob cleanup job and by PATCH confirm-upload.
  @@index([dprId])
  @@index([ulid])
  @@map("dpr_photo")
}

model DPRRevision {
  id          String   @id @default(uuid())
  dprId       String   @map("dpr_id")
  version     Int
  snapshot    Json
  changedAt   DateTime @default(now()) @map("changed_at")
  changedById String   @map("changed_by_id")

  dpr DPR @relation(fields: [dprId], references: [id], onDelete: Cascade)

  @@unique([dprId, version])
  // Round-7: revision list reads by dprId + ordering by changedAt; without
  // this index the audit trail read on /api/dpr/:id history hits a seq scan.
  @@index([dprId, changedAt])
  @@map("dpr_revision")
}

// ─────────────────────────────────────────────
// Inspection & Compliance Records Module (Round-12)
// ─────────────────────────────────────────────
// 15 sub-work types (material / cube / water / waterproofing / villa / day-
// activity / NCR / safety / major_deviation) used to live as nested rows
// inside DPR.workEntries. They are now first-class records that:
//   - FK to a DPR (nullable — for filings on Sundays / holidays)
//   - carry their own photos (DPR photos stay on the DPR)
//   - can be filtered by date range, project, type, severity, status
// inspectionType is the SUB_WORK_TYPE_OPTIONS value (e.g. 'material_inspection',
// 'cube_casting', 'ncr', 'safety_violation'). The structured field payload per
// type lives in WORK_TYPE_FIELDS (frontend/src/pages/portal/DprWorkTypes.jsx)
// and is stored as JSON in `data` for forward compatibility.

model InspectionRecord {
  id             String   @id @default(uuid())
  projectName    String
  location       String
  reportDate     DateTime @db.Date
  weather        String?
  contractor     String?
  dprId          String?  @map("dpr_id")
  inspectionType String   @map("inspection_type")
  data           Json
  status         String   @default("OPEN")
  // severity is meaningful for NCR / safety_violation / major_deviation;
  // null for routine inspections (material receipt, cube test, etc.).
  severity       String?
  submittedById  String   @map("submitted_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  dpr         DPR?             @relation(fields: [dprId], references: [id])
  submittedBy Employee         @relation("InspectionSubmitter", fields: [submittedById], references: [id])
  photos      InspectionPhoto[]

  // Indexes mirror DPR's pattern: owner + date for "my inspections this week",
  // dprId for "show me inspections on this DPR", and (date,id) for cursor
  // pagination in list views.
  @@index([submittedById, reportDate])
  @@index([dprId])
  @@index([reportDate, id])
  @@index([inspectionType])
  @@map("inspection_record")
}

model InspectionPhoto {
  id           String    @id @default(uuid())
  inspectionId String    @map("inspection_id")
  ulid         String
  container    String
  filename     String
  contentType  String    @map("content_type")
  sizeBytes    Int       @map("size_bytes")
  caption      String?
  location     String?
  takenAt      DateTime? @map("taken_at")
  uploadedAt   DateTime  @default(now()) @map("uploaded_at")

  inspection InspectionRecord @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@index([ulid])
  @@map("inspection_photo")
}

model Notification {
  id             String   @id @default(uuid())
  employeeId     String   @map("employee_id")
  type           String
  dprId          String?  @map("dpr_id")
  leaveRequestId String?  @map("leave_request_id")
  message        String
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")

  employee     Employee      @relation(fields: [employeeId], references: [id])
  dpr          DPR?          @relation(fields: [dprId], references: [id])
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)

  @@index([employeeId, createdAt])
  // Round-7: dpr relation is included in many read queries; index for joins.
  @@index([dprId])
  // Round-13: leave notifications join through leaveRequestId on the bell feed.
  @@index([leaveRequestId])
  @@map("notification")
}

// ─────────────────────────────────────────────
// Leave Request Module (Round-13)
// ─────────────────────────────────────────────
// Standard leave request workflow:
//   1. Employee submits POST /api/leave (status=PENDING).
//   2. Admin reviews via /portal/admin/leave; approve or reject
//      (status → APPROVED / REJECTED, with reviewedById/reviewedAt set).
//   3. Employee may cancel a PENDING request (status → CANCELLED).
//
// LeaveType is a string validated server-side (not an enum) so adding new
// leave categories (e.g. MATERNITY, COMP_OFF) is a non-migration change.
//
// Future extensibility hooks baked in:
//   - `metadata Json?` — for attachments, half-day flags, custom HR policies
//   - `cancelledAt` + `reviewNotes` columns present from day 1 so audit flows
//     in v2 don't need a schema migration.
//   - No `dayCount` column (holiday/weekend policy changes don't require
//     backfill).
//
// Indexes chosen for the hot reads:
//   - employee dashboard "my recent leave" → (employeeId, startDate)
//   - admin queue "pending leave oldest first" → (status, startDate)

model LeaveRequest {
  id           String    @id @default(uuid())
  employeeId   String    @map("employee_id")
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  leaveType    String    @default("CASUAL") @map("leave_type")
  reason       String
  status       String    @default("PENDING")
  reviewedById String?   @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewNotes  String?   @map("review_notes")
  cancelledAt  DateTime? @map("cancelled_at")
  metadata     Json?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  employee      Employee       @relation("LeaveSubmitter", fields: [employeeId], references: [id])
  reviewedBy    Employee?      @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  notifications Notification[]

  @@index([employeeId, startDate])
  @@index([status, startDate])
  @@index([startDate, endDate])
  @@map("leave_request")
}
