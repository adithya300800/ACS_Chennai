# Backend .env.example — copy to backend/.env (gitignored) and fill in real values.
# The server refuses to start if any *-required variable is missing.

# --- Database ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/acs_portal?schema=public"

# --- Auth (REQUIRED in all environments) ---
# Generate with: openssl rand -base64 64
# Minimum 32 chars; the server throws on boot if shorter.
JWT_SECRET="generate-a-strong-random-secret-here-min-32-chars"
JWT_REFRESH_SECRET="generate-another-strong-random-secret-here-min-32-chars"

# --- PII redaction (REQUIRED in all environments) ---
# Generate ONCE with: openssl rand -hex 32
# Must be stable across deploys so log correlation works. Never regenerate.
# The server throws on boot if missing.
PII_LOG_SALT="generate-with-openssl-rand-hex-32-and-pin-it"

# --- Server ---
PORT=3000
NODE_ENV=production

# --- Frontend URL (for CORS + OAuth redirects) ---
FRONTEND_URL="https://acschennai.com"

# --- Cloudflare R2 Storage (for DPR photos) ---
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"

# --- Email (Resend) — SERVER-SIDE ONLY ---
# NEVER prefix with VITE_ — Vite would inline this into the public JS bundle
# at acschennai.com and anyone could scrape it from the browser. The contact
# form posts to /api/contact which reads this server-side only.
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="info@acschennai.com"
RESEND_FROM_NAME="ACS Chennai"

# --- Round-25 portal notification emails ---
# Send transaction emails (DPR approved/rejected, training assigned, leave
# decisions, etc.) via the SAME Resend transport the contact form already uses.
#
# Why Resend and not SMTP: Render's free plan blocks outbound TCP/587 (and
# most other SMTP ports). HTTPS egress on 443 is unrestricted. Resend's free
# tier (100 emails/day, 3K/mo) covers portal notification volume.
#
# The same RESEND_API_KEY + RESEND_FROM_EMAIL + RESEND_FROM_NAME above drive
# BOTH the contact form (POST /api/contact) and the notification fan-out
# (5 IMMEDIATE types + 6 daily-digest types). One set of env vars, two
# send paths. Set these on the Render dashboard.
#
# NEVER prefix with VITE_ — these stay backend-only.
#
# (The previous round-25 docs documented a Zoho SMTP path via nodemailer.
# That path was abandoned because Render's free plan blocks outbound TCP/587.
# ZOHO_SMTP_* env vars on the dashboard can be removed safely — they're
# ignored.)

# --- Zoho OAuth (REQUIRED in production for /api/auth/zoho) ---
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REDIRECT_URI="https://acs-portal-api.azurewebsites.net/api/auth/zoho/callback"
ZOHO_DOMAIN="https://accounts.zoho.com"

# --- CORS allowlist (comma-separated) ---
ALLOWED_ORIGINS="https://acschennai.com"

# --- Email-domain allowlist for self-provisioning on Zoho callback ---
ALLOWED_EMAIL_DOMAINS="acschennai.com"

# --- Internal API token (gates /version endpoint) ---
INTERNAL_API_TOKEN="generate-with-openssl-rand-hex-32"

# --- Application Insights (optional, recommended) ---
# Wire the connection string from Azure Portal → App Service → Application Insights.
# Once set, the backend auto-instruments Express + Prisma + Azure SDK calls and
# surfaces unhandled rejections / slow requests / DB errors to a dashboard.
APPLICATIONINSIGHTS_CONNECTION_STRING=""
