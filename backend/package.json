{
  "name": "acs-portal-backend",
  "version": "1.0.0",
  "description": "ACS Chennai Employee Portal Backend API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:round13": "node scripts/round13-tests.js",
    "test:no-skipped": "node scripts/no-skipped-tests.js",
    "pretest": "node scripts/no-skipped-tests.js",
    "_comment_postinstall": "[N1] Recovery hook: clears failed rows in _prisma_migrations before migrate deploy can run. Runs during Render's `npm install` build step (postinstall fires inside that step), so it executes BEFORE the locked-in startCommand `npx prisma migrate deploy && node src/index.js`. Idempotent — no-op on healthy DBs.",
    "postinstall": "node scripts/clear-failed-migrations.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@azure/storage-blob": "^12.33.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.1",
    "handlebars": "^4.7.9",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.1.1",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "babel-jest": "^30.4.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/__tests__/jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/__tests__/jest.setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
